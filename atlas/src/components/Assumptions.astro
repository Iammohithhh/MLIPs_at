---
// Assumptions, units, boundary conditions and sign conventions — always in view
// next to a simulation or figure (CLAUDE.md scientific rules).
import { typesetInline } from '~/lib/typeset';

export interface AssumptionItem {
  term: string;
  value: string;
}

interface Props {
  items: AssumptionItem[];
  title?: string;
}

const { items, title = 'Assumptions, units & conventions' } = Astro.props;
---

<section class="assumptions" aria-label={title}>
  <p class="a-title">
    <svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13"
      ><path
        d="M8 1.5 15 14H1z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"></path><path d="M8 6v4M8 11.6v.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      ></path></svg
    >
    {title}
  </p>
  <dl>
    {
      items.map((it) => (
        <div>
          <dt>{it.term}</dt>
          <dd set:html={typesetInline(it.value)} />
        </div>
      ))
    }
  </dl>
</section>

<style>
  .assumptions {
    border: 1px dashed color-mix(in oklab, var(--atlas-caveat) 45%, var(--atlas-rule));
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    background: color-mix(in oklab, var(--atlas-caveat) 4%, transparent);
    font: 0.8125rem/1.5 var(--font-sans);
  }
  .a-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 650;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--atlas-caveat);
    margin-bottom: 0.5rem;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.4rem 1.5rem;
  }
  dt {
    font-weight: 600;
    color: var(--atlas-ink);
  }
  dd {
    color: var(--atlas-ink-muted);
  }
</style>

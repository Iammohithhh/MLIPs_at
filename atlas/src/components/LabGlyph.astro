---
// Small schematic drawings identifying each Physics Lab module. Decorative only
// (aria-hidden); colour comes from `currentColor`.
interface Props {
  id: string;
}
const { id } = Astro.props;
const dots = (pts: Array<[number, number, number?]>) => pts;
const lattice = Array.from({ length: 7 * 4 }, (_, k) => [18 + (k % 7) * 21, 14 + Math.floor(k / 7) * 19] as [number, number]);
---

<svg class="glyph" viewBox="0 0 160 84" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
  {
    id === 'P1' && (
      <g>
        <circle cx="52" cy="42" r="30" stroke-dasharray="4 3" opacity="0.6" />
        <circle cx="52" cy="42" r="7" fill="currentColor" />
        <circle cx="122" cy="42" r="9" fill="currentColor" opacity="0.55" />
        <path d="M60 42h52" opacity="0.5" stroke-dasharray="2 3" />
      </g>
    )
  }
  {
    id === 'P2' && (
      <g>
        {lattice.map(([x, y]) => (
          <circle cx={x} cy={y} r="3" fill="currentColor" opacity={Math.hypot(x - 81, y - 42) < 24 ? 1 : Math.hypot(x - 81, y - 42) < 46 ? 0.55 : 0.18} stroke="none" />
        ))}
        <circle cx="81" cy="42" r="24" />
        <circle cx="81" cy="42" r="46" stroke-dasharray="3 3" opacity="0.5" />
      </g>
    )
  }
  {
    id === 'P3' && (
      <g>
        <path d="M40 62 80 22 128 58" />
        <path d="M68 34a16 16 0 0 1 22 0" />
        {dots([[40, 62], [80, 22], [128, 58]]).map(([x, y]) => <circle cx={x} cy={y} r="7" fill="currentColor" stroke="none" />)}
      </g>
    )
  }
  {
    id === 'P4' && (
      <g>
        <path d="M58 52 80 34 102 52" />
        <circle cx="80" cy="34" r="8" fill="currentColor" stroke="none" />
        <circle cx="58" cy="52" r="5" fill="currentColor" stroke="none" opacity="0.6" />
        <circle cx="102" cy="52" r="5" fill="currentColor" stroke="none" opacity="0.6" />
        <path d="M40 66a46 30 0 0 0 80 0" opacity="0.6" />
        <path d="m114 60 6 6-8 2" />
      </g>
    )
  }
  {
    id === 'P5' && (
      <g>
        <ellipse cx="54" cy="28" rx="10" ry="16" fill="currentColor" opacity="0.5" stroke="none" />
        <ellipse cx="54" cy="58" rx="10" ry="16" opacity="0.8" />
        <ellipse cx="106" cy="42" rx="16" ry="10" fill="currentColor" opacity="0.5" stroke="none" />
        <ellipse cx="132" cy="42" rx="12" ry="8" opacity="0.8" />
        <path d="M74 42h12" />
        <path d="M78 38v8" />
      </g>
    )
  }
  {
    id === 'P6' && (
      <g>
        <path d="M10 70h140" opacity="0.4" />
        <path d="M14 70c10 0 10-50 20-50s10 50 20 50 10-50 20-50 10 50 20 50 10-50 20-50 10 50 20 50" opacity="0.5" stroke-dasharray="3 3" />
        <path d="M14 66c40 0 40-30 66-30s26 30 66 30" />
      </g>
    )
  }
  {
    id === 'P7' && (
      <g stroke="none">
        {lattice.map(([x, y], k) => (
          <circle cx={x} cy={y} r={3 + ((k * 7) % 5) * 0.6} fill="currentColor" opacity={0.15 + (((k * 37) % 11) / 11) * 0.85} />
        ))}
      </g>
    )
  }
  {
    id === 'P8' && (
      <g>
        <circle cx="40" cy="42" r="12" fill="currentColor" opacity="0.8" stroke="none" />
        <circle cx="120" cy="42" r="8" fill="currentColor" opacity="0.35" stroke="none" />
        <path d="M58 36c14-10 30-10 44 0" />
        <path d="m98 30 5 6-7 2" />
        <path d="M102 48c-14 10-30 10-44 0" opacity="0.4" />
      </g>
    )
  }
  {
    id === 'P9' && (
      <g>
        {[0, 1, 2].map((k) => (
          <rect x={14 + k * 46} y="18" width="40" height="48" rx="2" opacity={k === 1 ? 1 : 0.35} />
        ))}
        <path d="M80 30v24" stroke-width="2.5" />
        <path d="m74 36 6-7 6 7" />
      </g>
    )
  }
  {
    id === 'P10' && (
      <g>
        <path d="M30 14c14 70 86 70 100 0" />
        <path d="M22 26c20 56 96 56 116 0" stroke-dasharray="4 3" opacity="0.55" />
      </g>
    )
  }
  {
    id === 'P11' && (
      <g>
        <path d="M14 60c40-2 80-14 132-40" opacity="0.5" />
        <path d="M14 66c40 0 80-6 132-18M14 54c40-4 80-24 132-64" opacity="0.25" />
        {[20, 38, 56, 74, 92, 110, 128, 142].map((x, k) => (
          <circle cx={x} cy={60 - k * 4.5 + (k % 2 ? 5 : -4) * (k / 3)} r="3" fill="currentColor" stroke="none" />
        ))}
      </g>
    )
  }
  {
    id === 'P12' && (
      <g>
        <path d="M10 34c12-10 18 10 30 0s18 10 30 0 18 10 30 0 18 10 30 0 18 10 20 2" />
        <path d="M10 58c12-10 18 10 30 0s18 8 30-2 18 4 30-6 18-2 30-12 18-6 20-10" opacity="0.55" />
      </g>
    )
  }
</svg>

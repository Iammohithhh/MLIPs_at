---
// Brand motif (vision §9): an atomic neighbourhood shell that opens into a network
// of ideas. A centre atom, its neighbours inside a dashed cutoff shell, and two
// edges that leave the shell toward square "idea" nodes.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="15" cy="17" r="10.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2.1 2.1" opacity="0.5"
  ></circle>
  <g stroke="currentColor" stroke-width="1.1" opacity="0.55">
    <line x1="15" y1="17" x2="20.6" y2="11.8"></line>
    <line x1="15" y1="17" x2="9.2" y2="13.4"></line>
    <line x1="15" y1="17" x2="11.4" y2="22.6"></line>
    <line x1="15" y1="17" x2="20" y2="22.2"></line>
  </g>
  <g stroke="var(--atlas-arch)" stroke-width="1.2">
    <line x1="20.6" y1="11.8" x2="27.4" y2="4.6"></line>
    <line x1="11.4" y1="22.6" x2="5" y2="29"></line>
  </g>
  <circle cx="15" cy="17" r="3.3" fill="currentColor"></circle>
  <g fill="currentColor" opacity="0.8">
    <circle cx="20.6" cy="11.8" r="1.8"></circle>
    <circle cx="9.2" cy="13.4" r="1.8"></circle>
    <circle cx="11.4" cy="22.6" r="1.8"></circle>
    <circle cx="20" cy="22.2" r="1.8"></circle>
  </g>
  <rect x="25.6" y="2.8" width="3.6" height="3.6" rx="0.6" fill="var(--atlas-arch)"></rect>
  <rect x="3.2" y="27.2" width="3.6" height="3.6" rx="0.6" fill="var(--atlas-phys)"></rect>
</svg>

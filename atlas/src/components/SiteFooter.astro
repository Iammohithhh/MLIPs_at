---
import BrandMark from './BrandMark.astro';
---

<footer class="site-footer">
  <div class="inner">
    <div class="about">
      <a href="/" class="brand" aria-label="MLIP Atlas — home"><BrandMark size={22} /> MLIP Atlas</a>
      <p>
        An evidence-first atlas of machine-learning interatomic potentials. Architecture, checkpoint, dataset and
        benchmark result are kept distinct; every interactive and result is labelled with how it was produced.
      </p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/method/">How the Atlas is verified</a></li>
        <li><a href="/method/#labels">What the labels mean</a></li>
        <li><a href="/method/content-model/">Content model</a></li>
        <li><a href="/method/atomic-viewer/">Atomic viewer</a></li>
        <li><a href="/method/design-system/">Design system</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--atlas-rule);
    background: var(--atlas-surface-2);
  }
  .inner {
    max-width: 80rem;
    margin-inline: auto;
    padding: 2.25rem clamp(1rem, 4vw, 2.5rem) 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 4rem;
    justify-content: space-between;
    font: 0.875rem/1.55 var(--font-sans);
    color: var(--atlas-ink-muted);
  }
  .about {
    max-width: 34rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    color: var(--atlas-ink);
    text-decoration: none;
    margin-bottom: 0.5rem;
  }
  ul {
    display: grid;
    gap: 0.4rem;
  }
  nav a {
    color: var(--atlas-ink-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--atlas-ink);
    text-decoration: underline;
  }
</style>

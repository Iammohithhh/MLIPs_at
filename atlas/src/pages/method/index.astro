---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Badge from '~/components/Badge.astro';
import Callout from '~/components/Callout.astro';
import Math from '~/components/Math.astro';
import { LABELS, labelsInGroup, type LabelGroup, type LabelKey } from '~/lib/labels';

const groups: Array<{ id: LabelGroup; title: string; intro: string }> = [
  {
    id: 'status',
    title: 'Result status',
    intro: 'How a figure, number or interactive was produced. Exactly one applies to every result.',
  },
  {
    id: 'evidence',
    title: 'Evidence grades',
    intro:
      'Used in the Failure Atlas and on claims, alongside PUBLISHED RESULT and REPRODUCED, to separate proven failure, plausible mechanism and illustration.',
  },
  {
    id: 'provenance',
    title: 'Provenance markers',
    intro: 'Extra markers that stop illustrations and electronic-structure output being read as model predictions.',
  },
];

const rules = [
  'Architecture, checkpoint, implementation, dataset and evaluation are separate records, everywhere.',
  'Every non-trivial claim has a claim ID with a locator (figure, table or section), or is derived on the page.',
  'Benchmark numbers from incompatible protocols are never merged; every number carries its protocol, date and source.',
  'Proven failure, plausible mechanism and illustrative toy are kept apart and labelled.',
  'Every simulation lists assumptions, units, boundary conditions and sign/reference conventions in view.',
  'What an energy/force MLIP predicts is distinguished from what electronic-structure methods compute.',
  'Records are versioned, timestamped and diffable; the changelog is public.',
  'Visuals are original or licensed; reused figures are cited.',
  'Corrections are one click away from every claim (a pre-filled issue with the claim ID).',
  'Live results show exact reproduction code.',
  'Leaderboard snapshots are pulled automatically from the source, dated, and never editorialised into rankings.',
  'Accuracy over breadth: a record is not published until it passes review.',
];

const tiers: Array<{ id: string; where: string; what: string; labels: LabelKey[]; place: 'browser' | 'server' | 'offline' }> =
  [
    { id: 'T0', where: 'Browser · TypeScript', what: 'Analytic toys: Coulomb sums, QEq solves, 1D Poisson, cutoff functions', labels: ['toy-model'], place: 'browser' },
    { id: 'T1', where: 'Browser · WebGPU compute', what: 'Ewald sums, many-particle toy MD, field volumes', labels: ['toy-model', 'live-calculation'], place: 'browser' },
    { id: 'T2', where: 'Browser · lammps.js (WebAssembly)', what: 'Real classical MD with standard potentials (LJ, EAM, Tersoff)', labels: ['live-calculation'], place: 'browser' },
    { id: 'T3', where: 'Browser · ONNX Runtime Web', what: 'R&D: a small real MLIP on small systems', labels: ['live-calculation'], place: 'browser' },
    { id: 'T4', where: 'Atlas CPU inference server', what: 'Foundation-model Observatory: energies, forces, short scans on small structures', labels: ['live-calculation'], place: 'server' },
    { id: 'T5', where: 'Offline CPU precompute', what: 'Trajectories, phonons, Architecture X-ray tensors, reference data', labels: ['precomputed'], place: 'offline' },
  ];

const units = [
  { q: 'Length', u: 'Å', note: '1 Å = 0.1 nm' },
  { q: 'Energy', u: 'eV', note: 'per structure unless stated per atom' },
  { q: 'Force', u: 'eV/Å', note: 'F = −∂E/∂R (force points downhill)' },
  { q: 'Stress', u: 'eV/Å³', note: '1 eV/Å³ = 160.2177 GPa; sign convention stated per figure' },
  { q: 'Charge', u: 'e', note: 'elementary charge; model “charges” are labelled as latent or physical' },
  { q: 'Temperature', u: 'K', note: '' },
];

const phase1 = [
  { item: 'Astro project, layout, light/dark themes, self-hosted type', done: true },
  { item: 'Labels, figure captions, callouts, assumptions panels', done: true },
  { item: 'Build-time KaTeX with linked symbols', done: true },
  { item: 'Content schemas for every entity, with build-time integrity checks', done: true },
  { item: 'Impostor-sphere atomic viewer: cell, periodic images, shells, vectors, picking', done: true },
  { item: 'Viewer: distance/angle/dihedral measurement and structure upload (XYZ, POSCAR)', done: true },
  { item: 'Structure pipeline (ASE → typed JSON with provenance)', done: true },
  { item: 'Bibliography pipeline (Crossref / arXiv / OpenAlex) and the Papers chronology', done: true },
  { item: 'Search: Pagefind full text + Orama over records, ⌘K palette', done: true },
  { item: 'CI quality gates: types, tests, build with integrity checks, links, pipeline freshness', done: true },
  { item: 'Phase 2 — Physics Lab: P1 cutoff, P2 receptive field, P3 body order, P4 rotation, P5 harmonics, P6 Ewald, P8 charge equilibration, P9 periodic slabs', done: true },
  { item: 'Phase 3 — model pages (MACE, NequIP, Allegro, Behler–Parrinello), checkpoints, Data atlas, Benchmarks explorer, Explore map', done: true },
  { item: 'Phase 3 (continued) — SchNet page: live continuous-filter network and a toy SchNet showing which bond angles distance-only messages cannot separate; SchNet/SchNetPack/OCP records and an OC20 checkpoint', done: true },
  { item: 'Phase 3 (continued) — M3GNet and CHGNet page: M3GNet’s Bessel × harmonic three-body basis, exact bond and angle counts in four crystals with the models’ cutoffs, CHGNet’s magnetic-moment charge proxy', done: true },
  { item: 'Phase 3 (continued) — PET page: a toy PET block on ZnO showing cutoff-modulated attention keeps the energy smooth (plain softmax jumps), and live ECSE symmetrisation that makes it exactly invariant; PET, PET-MAD, MAD, PBEsol and metatrain records', done: true },
  { item: 'Phase 3 (continued) — Orb page: what a 20-neighbour limit does in fcc Cu (a 24-atom shell split by ordering; energy and force steps in a toy Orb-v3 GNS), shell ties in four crystals, and a live Equigrad lab (closed-form fit with a Δ_rot penalty; Δ_rot = −net torque derived on the page); Orb family, orb-models, orb-v3-conservative-inf-omat and claim records', done: true },
  { item: 'Phase 3 (continued) — eSEN and UMA page: a live SO(2) edge message in the bond frame (roll independence and exact equivariance versus a dense control; tensor-product vs SO(2) term counts), eSEN’s smoothness ablations, and a live UMA mixture-of-linear-experts lab (routing by composition/task/charge/spin, exact merging, vacancies, the N + 1 composition mean that breaks extensivity); eSCN, eSEN, UMA, fairchem, UMA-S 1.1 and claim records', done: true },
  { item: 'Phase 3 (continued) — GRACE page: star and tree cluster graphs counted live in Si, ZnO and Cu (3D, with the layers each needs), the ACE density trick computed two ways with its self-interaction terms split by body order (real Gaunt coefficients), layer recursion and chemical embedding; GRACE papers, gracemaker, GRACE-2L-OMAT-large-ft-AM and 10 claim records', done: true },
  { item: 'Phase 3 (continued) — SevenNet page: one rank’s owned and ghost atoms in α-quartz (3D; r_c vs T·r_c shells, node updates and traffic per force call), a toy message-passing network run serially and with SevenNet’s forward/reverse exchanges (exact to rounding; each exchange switchable), and SevenNet-MF’s one-hot fidelity as a bias (shift-only leaves forces unchanged); α-quartz structure, SevenNet-MF paper, SevenNet implementation, SevenNet-0 (11Jul2024) and SevenNet-MF-ompa checkpoints, 10 claims', done: true },
  { item: 'Phase 3 (continued) — Deep Potential and DPA page: which environments DeepPot-SE, DPA-1’s gated attention and a DPA-3-style angle embedding can tell apart (3D; fcc vs hcp exactly identical for the first two until hcp’s 1.633 d shell enters, from the Gram identity derived on the page), switch and softmax smoothness at the cutoff (DPA-2’s softmax*, DPA-3’s 8 × 10⁻⁷ residual), the least-squares energy bias and when it is not identifiable, LiGS graph sizes in five crystals; DeepPot-SE, DPA-1/2/3 and DeePMD-kit records, DPA-3.1-3M and DPA-3.1-MPtrj checkpoints, 12 claims', done: true },
  { item: 'Phase 3 (continued) — Long-range models page (4G-HDNNP, LES, CACE): a live C₁₀H₂/C₁₀H₃⁺ chain (3D) where local charges (3G-HDNNP, LES latent charges) cannot change beyond the 4.23 Å cutoff, rescaled charges shift uniformly and charge equilibration moves charge along the whole chain; the latent Ewald sum in the dimer benchmark’s 30 Å box (erf kernel, k_c ripples, tinfoil dipole term; Ewald identities and the rock-salt Madelung constant tested); CACE’s Cartesian moments in real crystals with their invariants and Legendre mix; King et al. Table 1 snapshotted by a tested pipeline module; 6 papers, 3 families, RuNNer/LES/CACE implementations, MACELES-OFF checkpoint, 14 claims', done: true },
  { item: 'Phase 3 (continued) — GAP and SOAP page: a live SOAP kernel explorer over seven lattices (3D density view, kernel matrix, power by angular channel; the Haar average derived on the page and checked against its closed form and a Monte Carlo rotation average), a sparse GAP trained in the browser on Stillinger–Weber Si cells with the Si GAP’s per-atom variance inside and outside the training range, and Pozdnyakov et al.’s degenerate pair (identical power spectra, different bispectra); five papers, GAP family, QUIP/GAP, Si GAP checkpoint with settings read from its released parameter file, its PW91 database, 8 claims', done: true },
  { item: 'Phase 4 (started) — Architecture X-ray: real MACE-MP-0a forward-pass tensors precomputed on CPU, with a two-pass rotation test', done: true },
  { item: 'Phase 4 — Physics Lab P12 Dynamics & stability: two synchronised LAMMPS (lammps.js, WebAssembly) runs in Web Workers, energy drift, g(r), MSD and a live time-step sweep', done: true },
  { item: 'Phase 4 — Model Observatory (precomputed on CPU): four MPtrj-trained checkpoints on identical inputs, force disagreement halo, E(V), dimer and adatom scans, rotation and closed-loop conservation tests', done: true },
  { item: 'Phase 4 — Representation Map (precomputed on CPU): invariant node features of MACE-MP-0a medium and small and an untrained MACE for 562 reference environments (98 ASE-built structures), raw and anchor-based (Li & Walsh) PCA maps linked to a 3D view, nearest-neighbour lists, CKA and mutual-kNN agreement; analysis maths tested', done: true },
  { item: 'Phase 4 — Representation Map, more architectures: CHGNet 0.3.0, SevenNet-0 and Orb v2 (all MPtrj) beside MACE, hooked at the vector each readout reads; a six-model agreement matrix; rotation, mirror and symmetry-equivalence tests per model (Orb v2 not rotation-invariant, SevenNet-0 trained without parity so mirror images differ); equivalence by 25 Å neighbour lists; CHGNet 0.3.0 and Orb v2 checkpoint records', done: true },
  { item: 'Phase 4 — Architecture X-ray for NequIP: NequIP-OAM-S 0.1 read from its torch.package archive without executing it and rebuilt with nequip 0.15.0; both convolutions path by path, the gate, trained Bessel frequencies, the ZBL prior (reproduced from its closed form; 1.5 eV per atom in diamond Si), dimer curves, a parameter budget, and rotation and exact mirror tests (no 1 ⊗ 1 → 1 path, derived on the page); Kavanagh et al. 2026 and ZBL records, NequIP-OAM-S checkpoint, 4 claims', done: true },
  { item: 'Phase 4 — Architecture X-ray for a long-range model: MACELES-OFF read with a restricted unpickler and rebuilt (mace-torch MACE plus its two charge readouts; LES real-space sum re-implemented and tested); per-atom features, latent charges by layer, latent potential, E_lr and its forces in 3D with a rotation test; an S22 water dimer pulled to 30 Å (the local part decouples once the graph splits at r_c, the LES tail matches the monomers’ multipoles); 557 les_fit test configurations with DFT forces, dipoles and Born effective charges (the latent-charge sign is not fixed by energies: dipoles and BECs anti-correlated with DFT); the stored 90.0474 LES constant; S22 paper and 3 claim records', done: true },
  { item: 'Phase 4 (remaining) — live CPU Observatory service (needs a deployment decision)', done: false },
  { item: 'Phase 5 (started) — Failure Atlas (PES softening, electrostatics at electrodes); Electrochemical Interface Lab panels 1–4 (image charge, interfacial water dipole with published Ag(111) orientations, LO–TO splitting, constant-potential strategies); Applications hub', done: true },
  { item: 'Phase 5 — Failure Atlas: surfaces (cleavage toy and benchmark), ion migration (barrier errors as diffusion errors), non-conservative forces (curl-vs-gradient toy dynamics plus the Observatory closed-loop test on four checkpoints)', done: true },
  { item: 'Phase 5 — Failure Atlas: experiment vs DFT reference (UniFFBench evidence, a reference-inheritance lab and the upstream per-mineral density errors re-plotted)', done: true },
  { item: 'Phase 5 — Interface Lab panel 4 (ion discharge, constant potential vs constant charge); Failure Atlas: catalysis (80 models × 14 tasks), small→large cell transfer (hypothesis with theory-backed mechanisms)', done: true },
  { item: 'Phase 5 — Battery application lab: 574 literature migration barriers of five foundation potentials recomputed from released data (three models reproduced exactly; CHGNet MAE discrepancy recorded), linked 3D hop viewer', done: true },
  { item: 'Phase 6 — Open data: every record, its JSON Schema and every benchmark snapshot as static JSON under /api/v1/; “What changed” digest from the repository history', done: true },
  { item: 'Phase 6 — Contribution workflow: GitHub issue forms (correction, new source, failure case), PR evidence checklist, CONTRIBUTING.md, /method/contribute/ with the review lifecycle, “Suggest a correction” links on Failure Atlas claims', done: true },
  { item: 'Phase 6 — 3D constellation on /explore/: the record graph lifted into four strata (physics → models and data → benchmarks and sources → evidence and use), selectable with linked neighbours', done: true },
  { item: 'Phase 6 — Citation universe on /papers/: about 2,100 works around the Atlas papers from OpenAlex, seeded 3D layout, colour by year or field, grow-from-1950 playback', done: true },
  { item: 'Phase 6 (remaining) — in-browser MLIP, AI navigator', done: false },
];
---

<BaseLayout
  title="How the Atlas is verified"
  description="The MLIP Atlas method: result labels, evidence grades, editorial rules, compute tiers, units and conventions."
>
  <article class="page-grid method">
    <header class="wide head">
      <p class="eyebrow">Method</p>
      <h1 class="h-display">How the Atlas is verified</h1>
      <p class="lede">
        The Atlas is only useful if you can tell, at a glance, what kind of thing you are looking at: a toy that
        illustrates a mechanism, a live calculation, a stored run, a published figure, or a published result the Atlas
        re-ran itself. This page defines the labels and the rules behind them.
      </p>
    </header>

    <section class="wide block" id="labels" aria-labelledby="labels-h">
      <h2 id="labels-h" class="h-section">Labels</h2>
      <div class="label-groups">
        {
          groups.map((g) => (
            <div class="label-group">
              <h3 class="h-sub">{g.title}</h3>
              <p class="group-intro">{g.intro}</p>
              <dl>
                {labelsInGroup(g.id).map((k) => (
                  <div id={`label-${k}`} class="label-row">
                    <dt>
                      <Badge label={k} size="md" link={false} />
                    </dt>
                    <dd>{LABELS[k].definition}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
      <Callout kind="caveat" title="The DFT rule">
        <p>
          A density of states, Fermi level or band alignment is an electronic-structure result on a named snapshot.
          It is labelled <Badge label="dft-reference" link={false} /> and never presented as the prediction of an
          energy/force MLIP — unless that model explicitly outputs the quantity.
        </p>
      </Callout>
    </section>

    <section class="block" aria-labelledby="rules-h">
      <h2 id="rules-h" class="h-section">Editorial rules</h2>
      <ol class="rules">{rules.map((r) => <li>{r}</li>)}</ol>
    </section>

    <section class="wide block" id="compute" aria-labelledby="tiers-h">
      <h2 id="tiers-h" class="h-section">Compute tiers</h2>
      <p class="prose-note">
        Every result carries its status label, and its provenance names the tier that produced it. Whether a result
        is a toy depends on the model, not the hardware: toy MD on the GPU is still a TOY MODEL. The site itself is
        static; 3D and toy physics run in your browser, live model inference runs on a CPU server, and heavy results
        are precomputed offline on CPU.
      </p>
      <ol class="tiers">
        {
          tiers.map((t) => (
            <li class={`tier place-${t.place}`}>
              <span class="tier-id">{t.id}</span>
              <span class="tier-where">{t.where}</span>
              <span class="tier-what">{t.what}</span>
              <span class="tier-label">
                {t.labels.map((l) => (
                  <Badge label={l} />
                ))}
              </span>
            </li>
          ))
        }
      </ol>
      <div class="tier-key" aria-hidden="true">
        <span class="k browser">in your browser</span>
        <span class="k server">Atlas CPU server</span>
        <span class="k offline">offline CPU</span>
      </div>
    </section>

    <section class="block" id="units" aria-labelledby="units-h">
      <h2 id="units-h" class="h-section">Units and conventions</h2>
      <p class="prose-note">
        Unless a figure says otherwise, the Atlas uses the units below. Forces are the negative gradient of the
        potential energy,
      </p>
      <Math display tex={String.raw`\vect{F}_i = -\frac{\partial E}{\partial \vect{R}_i},`} />
      <table class="units">
        <thead><tr><th scope="col">Quantity</th><th scope="col">Unit</th><th scope="col">Note</th></tr></thead>
        <tbody>
          {
            units.map((u) => (
              <tr>
                <th scope="row">{u.q}</th>
                <td>{u.u}</td>
                <td>{u.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="block" id="status" aria-labelledby="status-h">
      <h2 id="status-h" class="h-section">Build status</h2>
      <p class="prose-note">Foundations first, then each phase in dependency order (vision §VI).</p>
      <ul class="checklist">
        {
          phase1.map((p) => (
            <li class:list={{ done: p.done }}>
              <span class="tick" aria-hidden="true">{p.done ? '✓' : ''}</span>
              {p.item}
              <span class="sr-only">{p.done ? '(done)' : '(to do)'}</span>
            </li>
          ))
        }
      </ul>
      <p class="prose-note small">
        See the <a href="/method/design-system/">design system</a> for the visual components every page is built from,
        the <a href="/method/content-model/">content model</a> for the records behind them, and the
        <a href="/method/atomic-viewer/">atomic viewer</a> for how structures are drawn, and <a href="/method/open-data/">open data</a> to download every record and snapshot.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .method {
    padding-block: clamp(2rem, 5vw, 4rem) 4rem;
  }
  .head h1 {
    margin-block: 0.6rem 1rem;
  }
  .lede {
    font: 1.1875rem/1.6 var(--font-serif);
    color: var(--atlas-ink-muted);
    max-width: 44rem;
  }
  .block {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .block h2 {
    margin-bottom: 1rem;
  }
  .prose-note {
    font: 1.0625rem/1.6 var(--font-serif);
    color: var(--atlas-ink-muted);
    max-width: 44rem;
    margin-bottom: 1rem;
  }
  .prose-note.small {
    font-size: 0.9375rem;
    margin-top: 1rem;
  }
  .prose-note a {
    color: var(--atlas-arch);
  }

  .label-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.25rem;
  }
  .label-group {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--atlas-rule);
    border-radius: 0.7rem;
    background: var(--atlas-surface);
  }
  .group-intro {
    font-size: 0.875rem;
    color: var(--atlas-ink-muted);
    margin-block: 0.3rem 0.9rem;
  }
  .label-row {
    padding-block: 0.6rem;
    border-top: 1px solid var(--atlas-rule);
    scroll-margin-top: 6rem;
  }
  .label-row:target {
    background: color-mix(in oklab, var(--atlas-phys) 8%, transparent);
    border-radius: 0.4rem;
    padding-inline: 0.5rem;
  }
  .label-row dd {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--atlas-ink-muted);
  }

  .rules {
    counter-reset: rule;
    display: grid;
    gap: 0.6rem;
  }
  .rules li {
    counter-increment: rule;
    display: grid;
    grid-template-columns: 2rem 1fr;
    font: 1.0625rem/1.55 var(--font-serif);
  }
  .rules li::before {
    content: counter(rule);
    font: 600 0.8125rem/1.9 var(--font-sans);
    color: var(--atlas-ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .tiers {
    display: grid;
    gap: 0.5rem;
  }
  .tier {
    --tone: var(--atlas-phys);
    display: grid;
    grid-template-columns: 3rem minmax(10rem, 16rem) 1fr auto;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--atlas-rule);
    border-left: 4px solid var(--tone);
    border-radius: 0.5rem;
    background: var(--atlas-surface);
    font-size: 0.9rem;
  }
  .place-server { --tone: var(--atlas-arch); }
  .place-offline { --tone: var(--atlas-lit); }
  .tier-id {
    font: 700 0.9375rem var(--font-mono);
    color: var(--tone);
  }
  .tier-where {
    font-weight: 600;
  }
  .tier-what {
    color: var(--atlas-ink-muted);
  }
  .tier-label {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    justify-content: flex-end;
  }
  @media (max-width: 48rem) {
    .tier {
      grid-template-columns: 3rem 1fr;
    }
    .tier-what,
    .tier-label {
      grid-column: 2;
    }
  }
  .tier-key {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--atlas-ink-muted);
  }
  .k::before {
    content: '';
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    margin-right: 0.4rem;
    vertical-align: -0.1rem;
    border-radius: 2px;
    background: var(--c);
  }
  .k.browser { --c: var(--atlas-phys); }
  .k.server { --c: var(--atlas-arch); }
  .k.offline { --c: var(--atlas-lit); }

  .units {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .units th,
  .units td {
    text-align: left;
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid var(--atlas-rule);
  }
  .units thead th {
    font: 600 0.75rem var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--atlas-ink-faint);
  }
  .units td:nth-child(2) {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .units td:nth-child(3) {
    color: var(--atlas-ink-muted);
  }

  .checklist {
    display: grid;
    gap: 0.45rem;
  }
  .checklist li {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    font-size: 0.9375rem;
    color: var(--atlas-ink-muted);
  }
  .checklist li.done {
    color: var(--atlas-ink);
  }
  .tick {
    display: inline-grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 0.3rem;
    border: 1.5px solid var(--atlas-rule-strong);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--atlas-surface);
    flex: none;
  }
  .done .tick {
    background: var(--atlas-verified);
    border-color: var(--atlas-verified);
  }
</style>

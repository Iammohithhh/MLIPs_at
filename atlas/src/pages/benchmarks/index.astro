---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Figure from '~/components/Figure.astro';
import Callout from '~/components/Callout.astro';
import Cite from '~/components/Cite.astro';
import BenchmarkExplorer, { type MBModel } from '~/islands/BenchmarkExplorer';
import snapshot from '~/data/benchmarks/matbench-discovery.json';

const models = snapshot.models as unknown as MBModel[];
const src = snapshot.source;
const withKappa = models.filter((m) => m.metrics.kappa_srme !== null).length;
---

<BaseLayout
  title="Benchmarks"
  description="Benchmark results for machine-learned interatomic potentials, as published by the benchmarks themselves: Matbench Discovery metrics for every submitted checkpoint, explorable metric against metric, with the protocol and upstream commit for every number."
>
  <article class="page-grid bench">
    <header class="wide head">
      <p class="eyebrow">Benchmarks</p>
      <h1 class="h-display">What has been measured, and how?</h1>
      <p class="lede">
        A benchmark number belongs to one checkpoint, one test set, one protocol and one date. The Atlas copies results
        from the benchmark’s own repository, records exactly which revision they came from, and lets you compare them on
        any pair of axes. It never merges them into a ranking of its own.
      </p>
      <p class="snap">
        Snapshot of <a href={`${src.repo}/tree/${src.commit}/models`}>janosh/matbench-discovery</a> at
        <code>{src.commit.slice(0, 10)}</code> ({src.commit_date}), fetched {src.fetched}: {models.length} model entries,
        {withKappa} with a thermal-conductivity result.
      </p>
    </header>

    <section class="block" aria-labelledby="proto-h">
      <h2 id="proto-h" class="h-section">The Matbench Discovery protocol</h2>
      <dl class="proto">
        <div>
          <dt>Task</dt>
          <dd>
            From an <em>unrelaxed</em> structure only, predict how far the relaxed crystal lies above the convex hull of
            known phases; a structure counts as stable when it lies on or below the Materials Project hull
            <Cite id="riebesell2023matbench" locator="Sec. 2.1" />.
          </dd>
        </div>
        <div>
          <dt>Test set</dt>
          <dd>
            WBM structures generated by element substitution: 257,487 in full; after removing pathological structures,
            Materials Project matches and duplicate prototypes, 215,488 “unique prototypes”, of which 32,942 are stable
            <Cite id="riebesell2023matbench" locator="Sec. 2.1.2" />.
          </dd>
        </div>
        <div>
          <dt>F1, DAF</dt>
          <dd>
            F1 scores the stable/unstable classification. The discovery acceleration factor is precision divided by the
            fraction of stable structures — how many times better than random selection; its maximum on the
            unique-prototype set is about 6.5 <Cite id="riebesell2023matbench" locator="Sec. 3" />.
          </dd>
        </div>
        <div>
          <dt>κ_SRME</dt>
          <dd>
            Error in lattice thermal conductivity computed from the model’s phonons, a test of second- and third-order
            force constants rather than energies <Cite id="pota2024kappa" />.
          </dd>
        </div>
        <div>
          <dt>RMSD</dt>
          <dd>Distance between the model-relaxed and DFT-relaxed structures, a test of geometry optimisation.</dd>
        </div>
        <div>
          <dt>Training data</dt>
          <dd>
            “Compliant” submissions train only within the Materials Project release used to build the benchmark (MPtrj
            is a subset); others add OMat24, Alexandria or more. Results from different training data answer different
            questions — the colours below keep them apart.
          </dd>
        </div>
      </dl>
    </section>

    <div class="wide fig-wrap">
      <Figure title="Matbench Discovery results, metric against metric" labels={['published-result']} number={1} id="fig-bench" framed={false}>
        <BenchmarkExplorer client:visible models={models} source={src} />
        <Fragment slot="caption">
          Every dot is one submitted checkpoint, coloured by its training data and sized by parameter count. Choose any two
          metrics; select a dot for its provenance, licences and links. The benchmark’s combined score (CPS) is a weighted
          choice made on its website and is deliberately not recomputed here.
        </Fragment>
        <Fragment slot="source">
          Model files <code>models/*/*.yml</code> from <a href={src.repo}>github.com/janosh/matbench-discovery</a>, commit
          <code>{src.commit.slice(0, 10)}</code>; benchmark design <Cite id="riebesell2023matbench" />.
        </Fragment>
      </Figure>
    </div>

    <section class="block" aria-labelledby="read-h">
      <h2 id="read-h" class="h-section">Reading the results</h2>
      <Callout kind="caveat" title="What these numbers do not say">
        A high F1 for a checkpoint says it ranks hypothetical crystals well against a PBE/PBE+U hull; it says nothing
        directly about surfaces, liquids, interfaces or molecules, which are absent from this test set. The same
        architecture trained on different data can sit far apart here — compare MACE-MP-0 with later OMat-trained
        checkpoints — and a strong discovery score can coexist with a poor thermal-conductivity score, the signature of
        the potential-energy-surface softening described in the <a href="/physics-lab/">Physics Lab</a> and Failure Atlas.
      </Callout>
    </section>
  </article>
</BaseLayout>

<style>
  .bench {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }
  .head h1 {
    margin-block: 0.6rem 1rem;
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    text-wrap: balance;
  }
  .lede {
    font: 1.1875rem/1.6 var(--font-serif);
    color: var(--atlas-ink-muted);
    max-width: 46rem;
  }
  .snap {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.5rem 0.8rem;
    border: 1px dashed var(--atlas-rule-strong);
    border-radius: 0.5rem;
    font: 0.82rem/1.5 var(--font-sans);
    color: var(--atlas-ink-muted);
  }
  .snap a,
  .block a {
    color: var(--atlas-arch);
  }
  .block {
    margin-top: clamp(2rem, 4vw, 3rem);
    font: 1.0625rem/1.7 var(--font-serif);
  }
  .proto {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0.75rem;
    margin: 1rem 0 0;
  }
  .proto > div {
    padding: 0.8rem 1rem;
    border: 1px solid var(--atlas-rule);
    border-radius: 0.6rem;
    background: var(--atlas-surface);
  }
  .proto dt {
    font: 600 0.72rem var(--font-sans);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--atlas-lit);
  }
  .proto dd {
    margin: 0.3rem 0 0;
    font: 0.92rem/1.55 var(--font-sans);
    color: var(--atlas-ink);
  }
  .fig-wrap {
    margin-top: 1.5rem;
  }
</style>

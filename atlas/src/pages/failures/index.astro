---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Badge from '~/components/Badge.astro';
import type { Claim, FailureCase } from '~/content/schemas';
import type { LabelKey } from '~/lib/labels';

const cases = (await getCollection('failure-cases')).map((e) => ({ id: e.id, data: e.data as FailureCase }));
const claims = new Map((await getCollection('claims')).map((e) => [e.id, e.data as Claim]));
const gradeLabel: Record<string, LabelKey> = { THEORY: 'theory', PUBLISHED_RESULT: 'published-result', REPRODUCED: 'reproduced', TOY_DEMO: 'toy-demo', HYPOTHESIS: 'hypothesis' };

// Cases under investigation (vision §6). Listed so readers know what is coming; each
// opens only once its evidence is recorded with locators.
const queued = [
  'Ion migration barriers in battery materials',
  'Heterogeneous catalysis: adsorption energies',
  'Agreement with DFT versus agreement with experiment',
  'Transfer from small to large cells at solid–liquid interfaces (hypothesis-graded until supported)',
];
---

<BaseLayout
  title="Failure Atlas"
  description="Where machine-learned interatomic potentials fail, graded by evidence: published results, reproductions, theory, toy demonstrations and hypotheses kept apart, each case with its mechanisms, diagnostics and modelling responses."
>
  <article class="page-grid fa">
    <header class="wide head">
      <p class="eyebrow">Failure Atlas</p>
      <h1 class="h-display">Where models fail — and how we know</h1>
      <p class="lede">
        Every case states the failure as a checkable claim, shows the evidence with its locator, separates proven failure
        from plausible mechanism, and lists the diagnostics that would tell competing explanations apart. A case opens only
        when its evidence is recorded.
      </p>
      <div class="grades">
        <Badge label="published-result" /> <Badge label="reproduced" /> <Badge label="theory" /> <Badge label="toy-demo" /> <Badge label="hypothesis" />
      </div>
    </header>

    <section class="wide" aria-labelledby="open-h">
      <h2 id="open-h" class="h-sub sec">Open cases</h2>
      <ul class="cases">
        {
          cases.map((c) => (
            <li class="case">
              <a href={`/failures/${c.id}/`}>
                <Badge label={gradeLabel[c.data.grade]!} link={false} />
                <span class="t">{c.data.title}</span>
                <span class="s">{claims.get(c.data.claim)?.statement}</span>
                <span class="m">
                  {c.data.mechanisms.length} mechanism{c.data.mechanisms.length === 1 ? '' : 's'} · {c.data.diagnostics.length} diagnostic
                  {c.data.diagnostics.length === 1 ? '' : 's'} · {c.data.open_questions.length} open question{c.data.open_questions.length === 1 ? '' : 's'}
                </span>
                <span class="go">Open the case →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wide" aria-labelledby="q-h">
      <h2 id="q-h" class="h-sub sec">Under investigation</h2>
      <ul class="queued">{queued.map((q) => <li>{q}</li>)}</ul>
    </section>
  </article>
</BaseLayout>

<style>
  .fa {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }
  .head h1 {
    margin-block: 0.6rem 1rem;
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    text-wrap: balance;
  }
  .lede {
    font: 1.1875rem/1.6 var(--font-serif);
    color: var(--atlas-ink-muted);
    max-width: 46rem;
  }
  .grades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .sec {
    margin: clamp(2rem, 4vw, 3rem) 0 1rem;
  }
  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    gap: 1rem;
  }
  .case a {
    display: grid;
    gap: 0.55rem;
    padding: 1.2rem 1.35rem;
    border: 1px solid color-mix(in oklab, var(--atlas-fail) 35%, var(--atlas-rule));
    border-left: 4px solid var(--atlas-fail);
    border-radius: 0.75rem;
    background: var(--atlas-surface);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--atlas-shadow);
  }
  .case a:hover {
    background: color-mix(in oklab, var(--atlas-fail) 4%, var(--atlas-surface));
  }
  .t {
    font: 600 1.3rem/1.25 var(--font-serif);
  }
  .s {
    font: 0.92rem/1.55 var(--font-sans);
    color: var(--atlas-ink-muted);
  }
  .m {
    font: 0.75rem var(--font-mono);
    color: var(--atlas-ink-faint);
  }
  .go {
    font: 600 0.875rem var(--font-sans);
    color: var(--atlas-fail);
  }
  .queued {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.2rem;
    color: var(--atlas-ink-muted);
    font: 0.95rem/1.5 var(--font-sans);
  }
</style>

            </tr>
            {
              board.map((m) => (
                <tr>
                  <td>{m.name}</td>
                  <td>{m.training_sets.join(', ')}</td>
                  <td>—</td>
                  <td>{m.params ? `${(m.params / 1e6).toFixed(2)} M` : '—'}</td>

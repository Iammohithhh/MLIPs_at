---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Figure from '~/components/Figure.astro';
import Assumptions from '~/components/Assumptions.astro';
import Callout from '~/components/Callout.astro';
import Math from '~/components/Math.astro';
import Cite from '~/components/Cite.astro';
import RepresentationMap from '~/islands/RepresentationMap';
import raw from '~/data/representation/map.json';
import { atomCount, pairOf, type RepresentationMap as Data } from '~/lib/representation';

const map = raw as unknown as Data;
const nEnv = map.environments.length;
const nStruct = map.structures.length;
const nAtoms = atomCount(map);
const byId = (id: string) => map.models.find((m) => m.id === id)!;
const pair = (a: string, b: string) => pairOf(map, a, b)!;
const ms = pair('medium', 'small');
const mr = pair('medium', 'random');
const sr = pair('small', 'random');
const small = byId('small');
const random = byId('random');
const chg = byId('chgnet');
const sev = byId('sevennet');
const orb = byId('orb');
const f2 = (x: number) => x.toFixed(2);
const procr = (m: typeof small) => Object.entries(m.anchored).map(([k, p]) => ({ k, v: p.procrustes ?? 0 }));
const range = (m: typeof small) => {
  const v = procr(m).map((x) => x.v);
  return `${f2(globalThis.Math.min(...v))}–${f2(globalThis.Math.max(...v))}`;
};
const kinds = ['crystal', 'surface', 'defect', 'molecule'].map((k) => ({ k, n: map.structures.filter((s) => s.kind === k).length }));
const ck = map.source.checkpoints;
const ckMed = ck.medium!;
const ckSmall = ck.small!;
const SHORT: Record<string, string> = { medium: 'MACE-MP-0a medium', small: 'MACE-MP-0a small', random: 'untrained MACE', chgnet: 'CHGNet 0.3.0', sevennet: 'SevenNet-0', orb: 'Orb v2' };
const trainedOthers = ['small', 'chgnet', 'sevennet', 'orb'];
const ckaWithMedium = trainedOthers.map((id) => ({ id, v: pair('medium', id).cka })).sort((x, y) => y.v - x.v);
const sci = (v: number) => {
  if (v === 0) return '0';
  const e = globalThis.Math.floor(globalThis.Math.log10(v));
  const m = v / 10 ** e;
  return e >= -2 ? v.toFixed(2) : `${m.toFixed(1)} × 10<sup>${e}</sup>`;
};
const rows = map.models.map((m) => ({ m, inv: m.invariance }));
const sevEthanol = (() => {
  const s = map.structures.findIndex((x) => x.id === 'mol-CH3CH2OH');
  const es = map.environments.map((e, i) => ({ e, i })).filter(({ e }) => e.s === s && e.el === 'H' && e.mult === 2);
  return globalThis.Math.max(...es.map(({ i }) => sev.invariance.equiv_env[i]!));
})();
const assumptions = [
  { term: 'Reference set', value: `${nStruct} structures built with ASE: ${kinds.map((x) => `${x.n} ${x.k}${x.n === 1 ? '' : 's'}`).join(', ')}. Crystals are ideal, rattled (σ = 0.05 and 0.15 Å) and 5% compressed; lattice constants are inputs, not results. ${nAtoms} atoms, of which ${nEnv} have distinct environments (identical neighbour lists within 25 Å); identical ones are one point.` },
  { term: 'Features', value: 'For each model, the per-atom vector its energy readout reads. MACE: the invariant (0e) node features after each of the two interactions, concatenated (256). CHGNet 0.3.0: atom features after the last convolution and the readout layer norm (64). SevenNet-0: 0e features after the last interaction (128). Orb v2: node latents after the 15th message-passing step (256).' },
  { term: 'Models', value: 'Five released checkpoints, all trained on MPtrj: MACE-MP-0a medium and small, CHGNet 0.3.0, SevenNet-0 (11Jul2024), Orb v2 (MPtrj only); and the MACE medium architecture with random weights from torch.manual_seed(0). Each runs on CPU in its own package (mace-torch 0.3.16, chgnet 0.4.2, sevenn 0.13.0, orb-models 0.7.0); every checkpoint’s pickle is screened before loading and its SHA-256 recorded. CHGNet and SevenNet run in float32.' },
  { term: 'Cells', value: 'MACE sees molecules without a cell; the other packages need one, so molecules sit in a 20 Å box and slabs are made periodic along z (16 Å of vacuum, more than every cutoff).' },
  { term: 'Invariance tests', value: `Rotation: the whole structure and its cell by ${map.source.rotation.angle_deg}° about (${map.source.rotation.axis.join(', ')}). Mirror: z → −z. Equivalent atoms: identical (element, distance) lists within 25 Å, rounded to 10⁻³ Å; that is beyond every receptive field here except Orb’s. Displacements are in units of d_ref, the median distance from an environment to its nearest distinct one in the same model.` },
  { term: 'Maps', value: 'PCA to two components (no UMAP: it distorts global distances). Anchored maps: cosine similarity to K anchor environments chosen round-robin over elements with a fixed seed, the same anchors for every model, then PCA and an orthogonal Procrustes rotation onto the medium model’s map.' },
  { term: 'Not shown', value: 'Models trained on other data (OMat24, OMol25), your own structure (needs live inference), and which training data covers which region.' },
];
---

<BaseLayout
  title="Representation Map"
  description="Real latent features of five MPtrj-trained checkpoints (MACE, CHGNet, SevenNet, Orb) and an untrained control for a reference set of atomic environments, precomputed on CPU: linked 2D maps, the anchor-based relative representation, an agreement matrix, rotation, mirror and symmetry tests, and a 3D view of every environment."
>
  <article class="page-grid model-page">
    <header class="wide head">
      <p class="eyebrow"><a href="/models/">Models</a> · Representation Map</p>
      <h1 class="h-display">Representation Map</h1>
      <p class="lede">
        Inside every message-passing potential, each atom ends as a vector of learned numbers from which its energy is read. Two models
        trained on the same data learn different coordinates for those vectors, so they cannot be compared directly; a recent study
        compares them through their similarity to shared reference environments and finds a common geometry across seven foundation models
        <Cite id="li2026platonic" locator="Abstract; Figs. 1, 3" />. This page applies that method, on CPU, to the features of {nEnv} atomic
        environments from five released checkpoints of four architectures, all trained on the same data, and from MACE left untrained.
        Holding the data fixed leaves architecture and checkpoint as the only differences.
      </p>
    </header>

    <section class="block" aria-labelledby="what-h">
      <h2 id="what-h" class="h-section">What is being compared</h2>
      <p>
        MACE builds each atom’s features in two interactions of 6 Å each; the readout turns the invariant channels into the site energy
        (<a href="/models/mace/">MACE page</a>, <a href="/models/x-ray/">Architecture X-ray</a>). We take those invariant channels after each
        interaction, 256 numbers per atom, from MACE-MP-0a medium and small. Both were trained on MPtrj
        <Cite id="batatia2023foundation" />; they differ in that medium also carries l = 1 equivariant channels between layers. Raw features
        of different models live in unrelated coordinates: Li and Walsh found this even for MACE-MP-0 variants with the same data and
        objective <Cite id="li2026platonic" locator="Results; Fig. 1" />. Three more architectures trained on the same MPtrj data
        give the comparison its range; for each we take the per-atom vector that the energy readout reads:
      </p>
      <div class="table-wrap">
        <table class="models-table">
          <thead>
            <tr><th>model</th><th>architecture</th><th>symmetry of the features</th><th>reach</th><th>feature (per atom)</th></tr>
          </thead>
          <tbody>
            <tr><td><a href="/models/mace/">MACE-MP-0a</a> medium, small</td><td>equivariant ACE message passing</td><td>O(3): invariant to rotation and reflection</td><td>2 × 6 Å</td><td>{byId('medium').feature} ({byId('medium').dim})</td></tr>
            <tr><td><a href="/models/m3gnet-chgnet/">CHGNet 0.3.0</a> <Cite id="deng2023chgnet" /></td><td>invariant: distances and bond angles</td><td>O(3) by construction</td><td>4 × 6 Å</td><td>{chg.feature} ({chg.dim})</td></tr>
            <tr><td><a href="/models/sevennet/">SevenNet-0</a> <Cite id="park2024sevennet" /></td><td>equivariant NequIP-type</td><td>SO(3): rotations only (trained without parity; see below)</td><td>5 × 5 Å</td><td>{sev.feature} ({sev.dim})</td></tr>
            <tr><td><a href="/models/orb/">Orb v2</a> <Cite id="neumann2024orb" /></td><td>graph network simulator on raw bond vectors</td><td>none built in: learned from rotated data</td><td>15 × 6 Å, ≤ 20 neighbours</td><td>{orb.feature} ({orb.dim})</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        Raw features of different models have different lengths and unrelated coordinates. Li and Walsh’s remedy re-expresses every feature by its cosine similarity to
        K anchor environments, the same environments in every model <Cite id="li2026platonic" locator="Eqs. (1)–(2)" />:
      </p>
      <Math display number="1" tex={String.raw`\mathbf z_i = \big[\cos(\mathbf e_i, \mathbf a_1),\ \dots,\ \cos(\mathbf e_i, \mathbf a_K)\big]^{\mathsf T}, \qquad \cos(\mathbf e, \mathbf a) = \frac{\mathbf e^{\mathsf T}\mathbf a}{\lVert\mathbf e\rVert\,\lVert\mathbf a\rVert}`} />
      <p>
        The new coordinates no longer depend on how a model happens to orient or scale its latent space, only on which environments it finds
        alike. To compare whole spaces without any anchors we also use linear centred kernel alignment, which is unchanged by rotating or
        scaling either space and equals 1 for identical geometry, and the overlap of each environment’s ten nearest neighbours:
      </p>
      <Math display number="2" tex={String.raw`\mathrm{CKA}(X, Y) = \frac{\lVert Y_c^{\mathsf T} X_c\rVert_F^2}{\lVert X_c^{\mathsf T} X_c\rVert_F\, \lVert Y_c^{\mathsf T} Y_c\rVert_F}, \qquad \mathrm{mkNN} = \frac{1}{N}\sum_i \frac{\lvert \mathcal N_k^X(i) \cap \mathcal N_k^Y(i)\rvert}{k}`} />
      <p class="small">
        X<sub>c</sub>, Y<sub>c</sub>: the feature matrices (atoms × channels) with each column’s mean removed. Both quantities are checked on
        synthetic data in <code>pipeline/tests/test_representation.py</code> (CKA = 1 under rotation and scaling, mkNN = 1 for a rotated copy).
      </p>
    </section>

    <div class="wide fig-wrap">
      <Figure title="Six models, one set of environments" labels={['precomputed']} id="fig-map" framed={false}>
        <RepresentationMap client:visible />
        <Fragment slot="caption">
          Each point is one atomic environment, placed by PCA of one model’s features. Raw maps are in each model’s own coordinates; anchored
          maps use Eq. (1) and are rotated onto the MACE medium map, so they can be compared by eye. Select an environment to see it in 3D and
          which environments each model puts nearest to it. Below the 3D view: the agreement matrix of every pair, and how far each model moves
          environments that should not move at all.
        </Fragment>
        <Assumptions slot="assumptions" items={assumptions} />
        <Fragment slot="source">Features from CPU forward passes of <code>{ckMed.name}</code> (SHA-256 {ckMed.sha256!.slice(0, 12)}…), <code>{ckSmall.name}</code> ({ckSmall.sha256!.slice(0, 12)}…), <code>{ck.chgnet!.name}</code> ({ck.chgnet!.sha256!.slice(0, 12)}…), <code>{ck.sevennet!.name}</code> ({ck.sevennet!.sha256!.slice(0, 12)}…) and <code>{ck.orb!.name}</code> ({ck.orb!.sha256!.slice(0, 12)}…) by <code>pipeline/atlas_pipeline/representation.py</code>; method from <Cite id="li2026platonic" locator="Eqs. (1)–(2)" />. Analysis functions tested in <code>pipeline/tests/test_representation.py</code>, the data file in <code>src/lib/representation.test.ts</code>.</Fragment>
      </Figure>
    </div>

    <section class="block" aria-labelledby="read-h">
      <h2 id="read-h" class="h-section">What the map shows, and what it does not</h2>
      <p>
        <strong>Trained features agree more with each other than with an untrained network.</strong> The linear CKA between medium and
        small is {f2(ms.cka)}; between either and the random network it is {f2(mr.cka)} and {f2(sr.cka)}. After the anchor transform the
        small model’s map lands on the medium map with a Procrustes similarity of {range(small)} over K = 3 to 100; the untrained model’s with
        {range(random)}. This matches the direction of Li and Walsh’s result on seven models and 282,847 environments, where an untrained MACE
        showed no chemical organisation <Cite id="li2026platonic" locator="Fig. 3b,c" />, but with two checkpoints of one family and {nEnv}
        environments it is a demonstration of the method, not a measurement of convergence. Look at the untrained model’s anchored
        maps: its environments pile up in tight knots, each at the anchor from its own structure, with nothing arranging the knots by
        chemistry; the trained models spread the same environments into families of elements and bonding.
      </p>
      <p>
        <strong>With the data held fixed, agreement still follows architecture.</strong> Ranked by linear CKA with MACE medium, the
        trained models come out as {ckaWithMedium.map((x) => `${SHORT[x.id]} ${f2(x.v)}`).join(', ')}. SevenNet-0, the other e3nn
        equivariant network, is closest after MACE’s own small model; CHGNet, invariant and built from distances and angles, is further;
        Orb v2, with no built-in symmetry, is furthest from every other model and agrees less with MACE medium than the untrained MACE
        does ({f2(pair('medium', 'orb').cka)} against {f2(mr.cka)}). That ordering matches the published comparison, in which the
        equivariant models formed compact clusters and Orb-v3 stood apart <Cite id="li2026platonic" locator="Fig. 4; Sec. 2.3" />. Part
        of Orb’s distance is not chemistry at all, as the next section shows: its features also change when nothing but the orientation
        changes.
      </p>
      <p>
        <strong>Nearest-neighbour overlap is high for every pair, the untrained one included</strong> ({f2(ms.mknn_raw)}, {f2(mr.mknn_raw)}
        and {f2(sr.mknn_raw)} in raw space). Our reference set is built from rattled and compressed copies of each crystal, and any network
        that keeps element and geometry information, trained or not, puts those copies next to each other. On this set the metric rewards how
        the set was made. Li and Walsh, on a broad set of real crystals, report the opposite pattern: global alignment high, local
        neighbourhood agreement low <Cite id="li2026platonic" locator="Fig. 4a,b" />. A reference set has to be chosen for the question it is
        meant to answer. The exception is Orb v2 ({f2(pair('medium', 'orb').mknn_raw)} with MACE medium), for the reason below.
      </p>
      <Callout kind="caveat" title="Architecture ≠ checkpoint ≠ dataset">
        <p>
          Every trained model here saw the same data, so this page separates architecture from checkpoint but says nothing about data. The
          published comparison found the largest distances between OMat24-trained and MPtrj-trained models and between
          equivariant and non-equivariant ones <Cite id="li2026platonic" locator="Fig. 4c" />. Distances in these maps are distances between
          learned features, not energy differences, and a point far from the training data is not necessarily predicted badly, nor one
          near it predicted well.
        </p>
      </Callout>
    </section>

    <section class="block" aria-labelledby="invariance-h">
      <h2 id="invariance-h" class="h-section">Do environments that should not move, move?</h2>
      <p>
        A rotated crystal is the same crystal, and so is its mirror image; two symmetry-equivalent atoms are the same environment. A model
        whose features are exactly invariant gives such atoms identical vectors, up to floating-point rounding. We rotated every structure
        of the set as a whole, reflected it, and compared symmetry-equivalent atoms within each structure; the numbers are distances in
        feature space in units of d<sub>ref</sub>, the median distance from an environment to its nearest distinct one in that model.
        A value of 1 means the change moved the point as far as the step to a genuinely different environment.
      </p>
      <div class="table-wrap">
        <table class="models-table num">
          <thead>
            <tr><th>model</th><th>rotation, median</th><th>rotation, max</th><th>mirror, median</th><th>mirror, max</th><th>equivalent atoms, max ({rows[0]!.inv.equiv.n} groups)</th></tr>
          </thead>
          <tbody>
            {rows.map(({ m, inv }) => (
              <tr>
                <td>{SHORT[m.id]}</td>
                <td set:html={sci(inv.rot.median)} />
                <td set:html={sci(inv.rot.max)} />
                <td set:html={sci(inv.ref.median)} />
                <td set:html={sci(inv.ref.max)} />
                <td set:html={sci(inv.equiv.max)} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small">
        PRECOMPUTED on CPU. MACE runs in float64, so its residuals are of order 10<sup>−13</sup>; CHGNet and SevenNet run in float32 and
        sit near 10<sup>−5</sup>. Equivalence is decided on distances rounded to 10<sup>−3</sup> Å, so slightly asymmetric G2 molecule
        geometries leave about 10<sup>−5</sup> even for MACE. The strip plot in the figure shows every environment.
      </p>
      <p>
        <strong>MACE and CHGNet</strong> are invariant by construction and pass all three tests to rounding. <strong>Orb v2</strong> fails
        all three at the level of chemistry: a rigid rotation moves the median environment {f2(orb.invariance.rot.median)} d<sub>ref</sub>,
        and some by more than {globalThis.Math.floor(orb.invariance.rot.max)}. Orb learns rotational symmetry from rotated training data rather
        than building it in <Cite id="neumann2024orb" locator="Sec. 2.2; App. 6.2–6.3" />, and Li and Walsh saw the same for Orb-v3: rotating BaCeO₃ made
        its embeddings diverge <Cite id="li2026platonic" locator="Sec. 2.4, Fig. 5g" />. Equivalent atoms come apart too, most in slabs and
        compressed crystals, where Orb’s 20-neighbour limit can cut through a shell of equidistant neighbours in an order that depends on
        orientation and indexing (<a href="/models/orb/">Orb page</a>).
      </p>
      <p>
        <strong>SevenNet-0 passes the rotation test but not the mirror test.</strong> Its released checkpoint was trained with
        <code>is_parity: False</code>, so its spherical harmonics carry no parity (1x0e + 1x1e + 1x2e) and the network is equivariant
        under rotations only. Scalars built from three vectors, such as a triple product, are then allowed, and those change sign in a
        mirror. The two methylene hydrogens of ethanol are mirror images of each other: MACE and CHGNet give them the same vector,
        SevenNet-0 puts them {f2(sevEthanol)} d<sub>ref</sub> apart, and each matches the other’s mirror image exactly. Whether the
        readout uses that freedom is a separate question: the energy of mirrored ethanol changed by 4 × 10<sup>−6</sup> eV, at float32
        rounding. A feature space that tells mirror images apart is still a different space to compare, and it is an architecture-level
        property of this checkpoint’s settings, not of SevenNet as such.
      </p>
      <Callout kind="caveat" title="What these tests do and do not say">
        <p>
          They measure features, not energies or forces. A non-invariant feature can still give a nearly invariant energy if the readout
          averages the differences away, and the Observatory’s rotation test measures that directly for the same four checkpoints
          (<a href="/observatory/">Observatory</a>). They also depend on this reference set: the slabs, ideal crystals and small molecules here
          have many symmetry-equivalent atoms and ties in neighbour distance, which is where a neighbour limit or a learned symmetry shows.
        </p>
      </Callout>
    </section>

    <section class="block" aria-labelledby="next-h">
      <h2 id="next-h" class="h-section">Extending the map</h2>
      <p>
        The pipeline runs on CPU in about ten minutes for this set, each package in its own environment; adding a model means adding a
        hook on the vector its readout reads. Models trained on other data (OMat24, OMol25) would separate the effect of data from that of
        architecture, which this page holds fixed. Placing a visitor’s own structure on the map needs a forward pass at request time, which the
        Atlas does not run without a CPU inference service. Colouring by training-set coverage needs the training structures’ features, which
        is a larger computation than this page’s.
      </p>
    </section>

    <section class="block" aria-labelledby="res-h">
      <h2 id="res-h" class="h-section">Resources</h2>
      <ul>
        <li>The relative (“Platonic”) representation of foundation MLIPs: <Cite id="li2026platonic" />.</li>
        <li>MACE-MP-0 and its checkpoints: <Cite id="batatia2023foundation" />; <a href="https://github.com/ACEsuit/mace-mp">ACEsuit/mace-mp</a> (MIT).</li>
        <li>CHGNet: <Cite id="deng2023chgnet" />; SevenNet: <Cite id="park2024sevennet" />; Orb: <Cite id="neumann2024orb" />. Checkpoint records with licences and hashes: <a href="/models/checkpoints/">Checkpoints</a>.</li>
        <li>Data: <code>atlas/src/data/representation/map.json</code> (structures, environments, 2D maps, neighbour lists, agreement metrics and invariance tests).</li>
      </ul>
    </section>
  </article>
</BaseLayout>
<style>
  .model-page {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }
  .head .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .head h1 {
    margin-block: 0.6rem 1rem;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .lede {
    font: 1.1875rem/1.6 var(--font-serif);
    color: var(--atlas-ink-muted);
    max-width: 46rem;
  }
  .block a {
    color: var(--atlas-arch);
  }
  .block {
    margin-top: clamp(2rem, 4vw, 3rem);
    font: 1.0625rem/1.7 var(--font-serif);
  }
  .block p {
    margin-block: 0 1rem;
  }
  .fig-wrap {
    margin-top: 1.5rem;
  }
  .small {
    font-size: 0.9rem;
    color: var(--atlas-ink-muted);
  }
  .table-wrap {
    overflow-x: auto;
    margin-block: 0 1rem;
  }
  .models-table {
    width: 100%;
    border-collapse: collapse;
    font: 0.85rem/1.45 var(--font-sans);
  }
  .models-table th,
  .models-table td {
    padding: 0.4rem 0.6rem 0.4rem 0;
    border-bottom: 1px solid var(--atlas-rule);
    text-align: left;
    vertical-align: top;
  }
  .models-table th {
    font-size: 0.75rem;
    color: var(--atlas-ink-muted);
    font-weight: 600;
  }
  .models-table.num td:not(:first-child),
  .models-table.num th:not(:first-child) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>

---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Figure from '~/components/Figure.astro';
import Assumptions from '~/components/Assumptions.astro';
import Callout from '~/components/Callout.astro';
import Math from '~/components/Math.astro';
import Badge from '~/components/Badge.astro';
import Cite from '~/components/Cite.astro';
import OrbNeighbourLimit, { type LimitKey, type NeighbourLimitData } from '~/islands/OrbNeighbourLimit';
import OrbEquigrad from '~/islands/OrbEquigrad';
import cu from '~/data/structures/cu-fcc.json';
import si from '~/data/structures/si-diamond.json';
import nacl from '~/data/structures/nacl-rocksalt.json';
import zno from '~/data/structures/zno-wurtzite.json';
import snapshot from '~/data/benchmarks/matbench-discovery.json';
import type { Structure } from '~/lib/structure/types';
import { shellAround } from '~/lib/models/three-body';
import { ORB_K20, ORB_KINF, ORB_RMAX, droppedTiedNeighbour, limitCurve, limitCut, makeToyOrb, type LimitCurve, type Vec3 } from '~/lib/models/orb';
import { getEntry } from 'astro:content';
import type { Checkpoint } from '~/content/schemas';

const env = (s: unknown, R = ORB_RMAX): Vec3[] => shellAround(s as Structure, R).map((n) => n.p as Vec3);

// Fig. 1: one third-shell atom of fcc Cu moved radially through the 20th-neighbour distance.
const cuEnv = env(cu);
const moved = droppedTiedNeighbour(cuEnv, ORB_K20);
const rs = Array.from({ length: 111 }, (_, k) => 4.15 + k * 0.005);
const curves = {} as Record<LimitKey, LimitCurve>;
for (const mode of ['orb', 'distance'] as const) {
  const m = makeToyOrb({ mode });
  curves[`${mode}-20`] = limitCurve(m, cuEnv, moved, ORB_K20, rs);
  curves[`${mode}-inf`] = limitCurve(m, cuEnv, moved, ORB_KINF, rs);
}
const limitData: NeighbourLimitData = { vectors: cuEnv, moved, curves };

// Where a 20-neighbour limit cuts four crystals (computed at build time from the ASE structures).
const crystals = [
  { name: 'fcc Cu', s: cu },
  { name: 'diamond Si', s: si },
  { name: 'rock-salt NaCl (Na site)', s: nacl },
  { name: 'wurtzite ZnO (Zn site)', s: zno },
].map(({ name, s }) => ({ name, cut: limitCut(env(s).map((v) => globalThis.Math.hypot(...v)), ORB_K20) }));

// Fig. 2: the central Si atom and its four nearest neighbours, as an isolated cluster.
const si5 = env(si, 2.5);

const ck = (await getEntry('checkpoints', 'orb-v3-conservative-inf-omat'))!.data as Checkpoint;
const board = snapshot.models.filter((m) => m.family_dir === 'orb');

const limitAssumptions = [
  { term: 'Model', value: 'One message-passing step of an Orb-style GNS acting on the centre atom: Orb-v3 edge features (8 Bessel functions × real spherical harmonics, l ≤ 3, times the p = 4 envelope, Eq. 1), an MLP edge encoder, a sigmoid gate times the envelope, an edge MLP on [edge, sender, receiver], sum aggregation and a residual node update (Eqs. 2–3). 24 features, SiLU, random untrained weights: magnitudes mean nothing; continuity versus a step is exact.' },
  { term: 'Neighbour list', value: 'All atoms within 6 Å, sorted by distance; the first k kept. k = 20 and k = 120 are the values in orb-models for the “-20” and “-inf” checkpoints. Ties are broken by input order, as a sort must break them somehow.' },
  { term: 'Structure', value: 'fcc Cu, a = 3.615 Å (ASE), one atom and its 78 periodic neighbours within 6 Å; one of the 22 third-shell atoms the 20-neighbour list drops is moved along its bond direction.' },
  { term: 'Control', value: '“distance only” keeps the l = 0 column of the edge feature, which makes the toy rotation-invariant.' },
];
const equigradAssumptions = [
  { term: 'Model', value: 'The toy GNS of Fig. 1 with 64 features, frozen at random weights. Only a final linear layer on [message, updated node, 1] is fitted: weighted least squares on standardised features with ridge μ = 10⁻⁴, plus λ Σₙ ‖Δ_rot,n‖², which is quadratic in the readout, so the fit is closed-form.' },
  { term: 'Data', value: 'The central Si atom of diamond Si and its four nearest neighbours as an isolated cluster; each neighbour displaced by Gaussian noise of 0.12 Å per component. 120 training clusters in the crystal’s orientation; augmentation adds three uniformly random rotations of each (360). 20 test clusters, each in 8 random orientations.' },
  { term: 'Reference', value: 'Stillinger–Weber site energy of the central atom, ½ Σⱼ φ₂ + Σⱼ<ₖ φ₃ with the original Si parameters; rotation-invariant by construction. It stands in for DFT.' },
  { term: 'Penalty', value: 'λ multiplies the squared Frobenius norm of Δ_rot (the paper’s “L2 regularisation”); the released fine-tuning code penalises the unsquared norm. Δ_rot is evaluated by finite differences of exp(G − Gᵀ).' },
];
---

<BaseLayout
  title="Orb"
  description="Orb: a non-equivariant graph network simulator trained to be nearly rotation-invariant. Its gated message passing, Orb-v3's direct and conservative variants, what a 20-neighbour limit does in a crystal, Equigrad, checkpoints and limits."
>
  <article class="page-grid model-page">
    <header class="wide head">
      <p class="eyebrow"><a href="/models/">Models</a> · Model family</p>
      <h1 class="h-display">Orb</h1>
      <p class="lede">
        Orb gives up built-in symmetry for speed. It is a graph network simulator whose layers are plain MLPs acting on bond
        vectors, made approximately rotation-invariant by training on rotated structures
        <Cite id="neumann2024orb" locator="Secs. 2, 5" />. Orb-v3 then adds a conservative variant, smoother edge features and a
        penalty on the energy’s response to an infinitesimal rotation, and it is released in eight variants that trade
        speed against physical guarantees <Cite id="rhodes2025orbv3" locator="Sec. “Orb-v3 Models”" />.
      </p>
      <dl class="glance">
        <div><dt>Symmetry</dt><dd>Learned: rotation augmentation; Equigrad penalty in v3</dd></div>
        <div><dt>Locality</dt><dd>Message passing; v3: 6 Å, ≤ 20 or ≤ 120 neighbours, 5 steps</dd></div>
        <div><dt>Messages</dt><dd>Edge MLPs, sigmoid × envelope gates, sum aggregation</dd></div>
        <div><dt>Forces</dt><dd>v1/v2 direct; v3 direct or conservative (−∂E/∂r)</dd></div>
        <div><dt>Introduced</dt><dd>arXiv 2024 (v1, v2); Orb-v3 2025</dd></div>
        <div><dt>Code</dt><dd><a href="https://github.com/orbital-materials/orb-models">orb-models</a> (Apache-2.0)</dd></div>
      </dl>
      <p class="rule-note"><Badge label="schematic" /> This page is about the <strong>architecture</strong>; trained checkpoints are listed separately below.</p>
    </header>

    <section class="block" aria-labelledby="arch-h">
      <h2 id="arch-h" class="h-section">An encoder, a processor, a decoder</h2>
      <p>
        Orb follows the encoder–processor–decoder design of graph network simulators. Nodes start from species embeddings
        only, with no positions; geometry enters through the edges <Cite id="neumann2024orb" locator="Sec. 2.1" />. In Orb-v3 the
        initial edge feature is the outer product of eight Bessel radial functions and real spherical harmonics up to
        <i>l</i> = 3, multiplied by a smooth envelope <Cite id="rhodes2025orbv3" locator="App. C, “Smoother edge embeddings”" />:
      </p>
      <Math display number="1" tex={String.raw`e^{(0)}_{ij} = f_{\mathrm{env}}(r_{ij})\, \Big[ B_n(r_{ij})\, Y_{lm}(\hat{\mathbf r}_{ij}) \Big]_{n \le 8,\; l \le 3}, \qquad B_n(r) = \sqrt{\tfrac{2}{r_{\max}}}\,\frac{\sin(n\pi r / r_{\max})}{r}`} />
      <p>
        with <i>r</i><sub>max</sub> = 6 Å and the polynomial envelope
        <Math tex={String.raw`f_{\mathrm{env}}(r) = 1 - 15x^4 + 24x^5 - 10x^6`} />, <i>x</i> = <i>r</i>/<i>r</i><sub>max</sub>, whose value,
        slope and curvature vanish at the cutoff (orb-models, <code>nn_util.get_cutoff</code>). The spherical harmonics are
        the same ones equivariant models use, but here their 16 components are flattened into a vector and handed to an
        ordinary MLP, so nothing forces them to be combined into invariants. Each processor step then updates edges and
        nodes <Cite id="neumann2024orb" locator="Sec. 2.2" />:
      </p>
      <Math display number="2" tex={String.raw`\varepsilon_{ij} = \phi^{k}_{\mathrm{edge}}\big([\,e_{ij},\, v_i,\, v_j\,]\big), \qquad \psi_{ij} = \sigma\big(\mathbf w_{\psi}\!\cdot e_{ij}\big)\, f_{\mathrm{env}}(r_{ij})`} />
      <Math display number="3" tex={String.raw`v_i \leftarrow v_i + \phi^{k}_{\mathrm{node}}\Big(\Big[\,v_i,\; \sum_{j} \psi_{ij}\,\varepsilon_{ij},\; \sum_{j} \psi'_{ji}\,\varepsilon_{ji}\,\Big]\Big), \qquad e_{ij} \leftarrow e_{ij} + \varepsilon_{ij}`} />
      <p>
        The paper calls the gates a smoothed attention; they are sigmoids, not a softmax, so there is no competition between
        neighbours, and the envelope makes every edge fade out before <i>r</i><sub>max</sub>
        <Cite id="neumann2024orb" locator="Sec. 2.2" />. Orb-v3 runs five such steps with 1024-wide MLPs, about 25 million
        parameters, where Orb-v2 used fifteen narrower ones <Cite id="rhodes2025orbv3" locator="App. C, “Width over depth”" />.
        Decoders read energy, forces and stress from the node features. In the “direct” models forces and stress are
        outputs of their own heads; in the “conservative” ones they are derivatives of the energy
        <Cite id="rhodes2025orbv3" locator="Sec. “Orb-v3 Models”; App. C" />,
      </p>
      <Math display number="4" tex={String.raw`\textbf{direct: } \mathbf F_i = \mathrm{MLP}_F(v_i), \qquad \textbf{conservative: } \mathbf F_i = -\frac{\partial E}{\partial \mathbf r_i},\;\; \sigma = \frac{1}{V}\frac{\partial E}{\partial \boldsymbol\epsilon}`} />
      <ol class="flow" aria-label="One Orb processor step">
        <li><span>edge</span> MLP of [edge, sender, receiver]</li>
        <li class="key"><span>gate</span> sigmoid × f<sub>env</sub>(r)</li>
        <li><span>aggregate</span> sum over neighbours</li>
        <li><span>update</span> node and edge residuals</li>
      </ol>
      <p>
        Which neighbours become edges is decided before any of this. Orb keeps, for every atom, at most <i>k</i> of the atoms
        within 6 Å, the nearest ones: <i>k</i> = 20 for the “-20” checkpoints and 120 for “-inf”, a value the code calls
        effectively unlimited for the training distribution (orb-models, <code>pretrained.py</code>). Orb-v2 also had a
        20-neighbour limit <Cite id="rhodes2025orbv3" locator="Sec. “Neighbor limits”" />. The authors report that the
        limit induces “subtle discontinuities” in the potential energy surface <Cite id="rhodes2025orbv3" locator="App. C" />.
        Figure 1 shows where they come from in a real crystal.
      </p>
    </section>

    <div class="wide fig-wrap">
      <Figure title="Twenty neighbours in a crystal with twenty-four equivalent ones" labels={['toy-model', 'live-calculation']} number={1} id="fig-limit" framed={false}>
        <OrbNeighbourLimit client:visible data={limitData} />
        <Fragment slot="caption">
          In fcc Cu the 20 nearest neighbours are the 12 + 6 of the first two shells plus 2 of the 24 atoms of the third shell
          at 4.43 Å. Drag one of the 22 dropped third-shell atoms inward and it becomes an edge in place of an equivalent one.
          Moved back past 4.43 Å, it vanishes from the graph while still well inside the cutoff, where its gate is far from zero.
          The force on it falls to zero at that distance (bottom). With Orb-v3’s direction-dependent edge features, the energy
          steps too (top).
        </Fragment>
        <Assumptions slot="assumptions" items={limitAssumptions} />
        <Fragment slot="source">Architecture from <Cite id="neumann2024orb" locator="Sec. 2.2" /> and <Cite id="rhodes2025orbv3" locator="App. C" />; cutoff, envelope and neighbour limits from orb-models (commit 1794f85). Curves computed at build time, the view and readouts in your browser, by the tested module <code>src/lib/models/orb.ts</code>.</Fragment>
      </Figure>
    </div>

    <section class="block" aria-labelledby="ties-h">
      <h3 id="ties-h" class="h-sub">Where a 20-neighbour limit cuts four crystals</h3>
      <div class="table-wrap">
        <table class="ck">
          <thead><tr><th>Structure</th><th>Neighbours within 6 Å</th><th>20th distance</th><th>Atoms at that distance</th><th>Of those, kept</th><th>Dropped inside 6 Å</th></tr></thead>
          <tbody>
            {
              crystals.map(({ name, cut }) => (
                <tr>
                  <td>{name}</td>
                  <td>{cut.inside}</td>
                  <td>{cut.rk.toFixed(3)} Å</td>
                  <td>{cut.tied}</td>
                  <td>{cut.tiedKept}</td>
                  <td>{cut.dropped}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small">
        Computed from the ASE structures used across the Atlas. In the three cubic crystals the 20th place falls inside a shell
        of symmetry-equivalent atoms, so the graph of a perfect crystal already treats equivalent atoms differently. Any
        displacement then reorders them, and every crossing of the 20th distance is a step like Fig. 1’s. The 120-neighbour limit
        drops nothing in any of them. Wurtzite ZnO (ASE, <i>u</i> = 0.382) has no exact tie at its 20th place, but its
        shells are split by less than 0.01 Å, so small vibrations reorder them as well.
      </p>
    </section>

    <section class="block" aria-labelledby="sym-h">
      <h2 id="sym-h" class="h-section">Symmetry: augmentation, then Equigrad</h2>
      <p>
        Orb-v1 and v2 are trained on randomly rotated copies of every structure and are, in the authors’ words, approximately
        roto-invariant and equivariant <Cite id="neumann2024orb" locator="Sec. 5; App. 6.2" />. Their direct forces are
        post-processed: the mean force is subtracted and, for non-periodic systems, the net torque is removed
        <Cite id="neumann2024orb" locator="App. 6.3" />. Orb-v3 adds a measure of how far the energy is from invariant. Rotate
        the positions <b>r</b> and the cell <b>h</b> by <i>R</i> = exp(<i>G</i> − <i>G</i><sup>T</sup>) and differentiate at
        the identity <Cite id="rhodes2025orbv3" locator="Sec. “Equigrad”, Eq. (1)" />:
      </p>
      <Math display number="5" tex={String.raw`\Delta_{\mathrm{rot}} = \frac{\partial E(\mathbf r R,\; \mathbf h R)}{\partial G}\bigg|_{G = 0}, \qquad R = e^{\,G - G^{\mathsf T}}`} />
      <p>
        An invariant energy has Δ<sub>rot</sub> = 0. For a conservative model the derivative comes out of the same backward
        pass that produces forces and stress, so an L2 penalty on it costs nothing extra. The authors report that this
        improved measured invariance about fivefold on the 103 structures of the thermal-conductivity benchmark
        <Cite id="rhodes2025orbv3" locator="Sec. “Equigrad”; Fig. 3" />.
      </p>
      <Callout kind="derivation" title="What Δ_rot is for an isolated system">
        <p id="equigrad-derivation">
          Write positions as row vectors, as the code does: <b>r</b>′<sub>i</sub> = <b>r</b><sub>i</sub> e<sup>A</sup> ≈
          <b>r</b><sub>i</sub>(1 + <i>A</i>) with <i>A</i> = <i>G</i> − <i>G</i><sup>T</sup>. With <b>g</b><sub>i</sub> =
          ∂<i>E</i>/∂<b>r</b><sub>i</sub> = −<b>F</b><sub>i</sub>, the chain rule gives
        </p>
        <Math display tex={String.raw`(\Delta_{\mathrm{rot}})_{ab} = \sum_i \big( r_{i,a}\, g_{i,b} - r_{i,b}\, g_{i,a} \big) = -\,\epsilon_{abc}\, T_c, \qquad \mathbf T = \sum_i \mathbf r_i \times \mathbf F_i`} />
        <p>
          so Δ<sub>rot</sub> is antisymmetric, ‖Δ<sub>rot</sub>‖<sup>2</sup><sub>F</sub> = 2‖<b>T</b>‖<sup>2</sup>, and
          penalising it penalises the net torque that a non-invariant energy exerts on an isolated cluster. Its forces are
          then not physical even when they are exact gradients. For a periodic system the cell term adds the
          antisymmetric part of the cell virial. The identity is checked numerically in <code>src/lib/models/orb.test.ts</code>.
        </p>
      </Callout>
    </section>

    <div class="wide fig-wrap">
      <Figure title="Teaching invariance to a model that does not have it" labels={['toy-model', 'live-calculation']} number={2} id="fig-equigrad" framed={false}>
        <OrbEquigrad client:visible base={si5} />
        <Fragment slot="caption">
          A frozen toy Orb with a fitted last layer, trained on rattled Si₅ clusters, all in one orientation. Turn the test
          cluster: the fit is accurate only near the orientation it was trained in, and its forces exert a net torque (arrow) on
          an isolated cluster. Raising λ flattens the curve and shrinks Δ<sub>rot</sub>. Augmentation with rotated copies
          does much of the same job with data. Here the two compete with accuracy, because the frozen features cannot be
          re-learned.
        </Fragment>
        <Assumptions slot="assumptions" items={equigradAssumptions} />
        <Fragment slot="source">Δ<sub>rot</sub> as defined in <Cite id="rhodes2025orbv3" locator="Eq. (1)" />. Computed in your browser by <code>src/lib/models/orb.ts</code>; the torque identity, closed-form fit and the trends quoted here are tested in <code>orb.test.ts</code>.</Fragment>
      </Figure>
    </div>

    <section class="block" aria-labelledby="maths-h">
      <h2 id="maths-h" class="h-section">The mathematics at three depths</h2>
      <div class="depths">
        <input type="radio" name="depth" id="o-int" checked />
        <label for="o-int">Intuition</label>
        <input type="radio" name="depth" id="o-tech" />
        <label for="o-tech">Technical</label>
        <input type="radio" name="depth" id="o-res" />
        <label for="o-res">Research</label>
        <div class="depth depth-int">
          <p>
            Orb looks at each bond’s length and direction in a fixed x-y-z frame and passes messages along the bonds, much as a
            physics simulator for particles would. It is not told that turning a crystal round changes nothing; it learns this
            from examples shown in many orientations, and Orb-v3 is also penalised whenever a tiny rotation would change its
            energy. To stay fast, each atom listens to at most 20 (or 120) neighbours.
          </p>
        </div>
        <div class="depth depth-tech">
          <p>
            Eqs. (1)–(3) are permutation-invariant and translation-invariant (only relative vectors enter) but not
            rotation-invariant: the MLPs take Cartesian-frame components of <i>Y</i><sub>lm</sub>. Smoothness in <i>r</i> comes
            from the envelope in both the edge feature and the gate. Smoothness in the <em>neighbour set</em> does not, which is
            why the “-20” models have discontinuities (Fig. 1) and only orb-v3-conservative-inf is reported to conserve energy in
            NVE <Cite id="rhodes2025orbv3" locator="App. E; Fig. 7" />. Direct models have more freedom and, trained on MPtrj
            plus Alexandria, overfit forces. Their -mpa versions were therefore distilled from the conservative model
            <Cite id="rhodes2025orbv3" locator="Sec. “Datasets and distillation”; App. H" />.
          </p>
        </div>
        <div class="depth depth-res">
          <p>
            Orb is the opposite bet to <a href="/models/nequip/">NequIP</a> and <a href="/models/mace/">MACE</a>: spend no
            capacity or compute on exact symmetry and buy it back approximately with data and a regulariser. Equigrad measures
            only the first-order response at the training points. Fig. 2 shows the gap this leaves away from them. Measured
            invariance is a property of a checkpoint, not of the architecture, and has to be reported per model. Approximate
            symmetry also breaks tools that assume exact symmetry. Phonopy’s default <code>is_plusminus='auto'</code> skips
            displacements that symmetry makes redundant, which is invalid for a non-invariant potential; the authors trace part
            of a κ discrepancy to it <Cite id="rhodes2025orbv3" locator="App. C; Fig. 3 (right)" />.
            <a href="/models/pet/">PET</a> shares the learned-symmetry philosophy but can restore exact invariance afterwards by
            frame averaging.
          </p>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="out-h">
      <h2 id="out-h" class="h-section">Outputs</h2>
      <p>
        Energy, forces and stress, directly or as derivatives depending on the variant. Orb-v3 also has a confidence head that
        classifies each atom’s force error into bins from detached node features, giving an intrinsic uncertainty estimate
        <Cite id="rhodes2025orbv3" locator="Algorithm 1; Fig. 4" />. A fixed ZBL pair repulsion is added for short distances,
        and losses are Huber <Cite id="rhodes2025orbv3" locator="App. C, “Huber loss and pair repulsion”" />. Orb-v2 was also released
        with D3 dispersion folded into its training targets <Cite id="neumann2024orb" locator="Secs. 2.3.3, 2.4" />. The
        repository now also distributes OrbMol models trained on OMol25, conditioned on total charge and spin; OrbMol-v2 adds
        learned per-atom charges with a Coulomb term (orb-models <code>MODELS.md</code>). Those are not recorded here yet.
        The materials checkpoints have no long-range electrostatics.
      </p>
    </section>

    <section class="block" aria-labelledby="fail-h">
      <h2 id="fail-h" class="h-section">Where it can fail</h2>
      <p>
        <strong>From the architecture.</strong> Rotational invariance is approximate. Predictions depend slightly on
        orientation, and a conservative model then exerts a spurious net torque (Fig. 2). A finite neighbour limit makes the
        energy, or at least the forces, discontinuous whenever atoms reorder around the <i>k</i>-th distance (Fig. 1). The
        repository’s model notes warn that this can matter for sensitive calculations such as Hessians. Direct forces are not gradients, so
        NVE energy drifts <Cite id="rhodes2025orbv3" locator="App. E; Fig. 7" /> (see the
        <a href="/failures/nonconservative-forces/">Failure Atlas case</a> on non-conservative forces). Like every local model
        it has no electrostatics beyond 6 Å (<a href="/physics-lab/ewald/">P6</a>).
      </p>
      <p>
        <strong>From a checkpoint.</strong> The -omat models learned OMat24’s PBE/PBE+U bulk data, and only its AIMD subset
        <Cite id="rhodes2025orbv3" locator="App. I" />. Surfaces, molecules and interfaces are extrapolation, and the model notes
        advise caution there. The -mpa models learned MPtrj plus Alexandria, so their energies are on a different reference
        from the -omat models. Compare them only on quantities that do not depend on absolute energies, or after recomputing
        references. The thermal-conductivity result of a non-invariant model can also depend on the finite-difference step and on
        floating-point precision <Cite id="rhodes2025orbv3" locator="App. F; Fig. 8" />.
      </p>
    </section>

    <section class="block" aria-labelledby="ck-h">
      <h2 id="ck-h" class="h-section">Checkpoints</h2>
      <div class="table-wrap">
        <table class="ck">
          <thead><tr><th>Checkpoint</th><th>Training data</th><th>Forces</th><th>Neighbours</th><th>Parameters</th><th>Weights licence</th><th>Weights</th></tr></thead>
          <tbody>
            <tr>
              <td>{ck.name}</td>
              <td>OMat24 (AIMD subset), PBE/PBE+U</td>
              <td>conservative</td>
              <td>≤ 120 in 6 Å</td>
              <td>≈ 25 M</td>
              <td>{ck.licence}</td>
              <td><a href={ck.weights?.url}>{ck.version}</a></td>
            </tr>
            {
              board.map((m) => (
                <tr>
                  <td>{m.name}</td>
                  <td>{m.training_sets.join(', ')}</td>
                  <td>{m.targets.endsWith('_G') ? 'conservative' : 'direct'}</td>
                  <td>—</td>
                  <td>{m.params ? `${(m.params / 1e6).toFixed(1)} M` : '—'}</td>
                  <td>{m.licence_checkpoint ?? '—'}</td>
                  <td><a href={m.checkpoint_url}>{m.version}</a></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small">
        The first row is the configuration the repository suggests for initial testing; its parameter count is the paper’s figure
        for the 5-layer model. The other rows are the Orb models submitted to Matbench Discovery (snapshot
        {snapshot.source.commit_date}; leaderboard parameter counts and training-set labels), whose results are on the
        <a href="/benchmarks/">Benchmarks</a> page. The other Orb-v3 variants (direct or conservative, 20 or inf, omat or
        mpa) are listed in the repository’s <code>MODELS.md</code> and are not yet recorded here individually.
      </p>
      <Callout kind="note" title="Related families">
        <a href="/models/pet/">PET</a> also learns rotational symmetry from data. <a href="/models/schnet/">SchNet</a> and
        <a href="/models/m3gnet-chgnet/">M3GNet/CHGNet</a> stay invariant by using only distances and angles.
        <a href="/models/nequip/">NequIP</a>, <a href="/models/allegro/">Allegro</a> and <a href="/models/mace/">MACE</a> build
        exact equivariance into every layer.
      </Callout>
    </section>

    <section class="block" aria-labelledby="res-h">

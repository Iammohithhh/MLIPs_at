---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Badge from '~/components/Badge.astro';
import ReceptiveFieldFigure from '~/components/ReceptiveFieldFigure.astro';
import Assumptions from '~/components/Assumptions.astro';
import InterfaceExplorer from '~/islands/InterfaceExplorer';
import { DESTINATIONS } from '~/lib/destinations';
import { labelsInGroup, LABELS } from '~/lib/labels';

const statusLabels = labelsInGroup('status');

const ixAssumptions = [
  { term: 'System', value: 'Illustrative Au(111) slab (4 layers, a = 4.078 Å) under a 13 Å water film with one Na⁺ and one Cl⁻; periodic in x and y, open along z.' },
  { term: 'Positions', value: 'Placed by rule (lattice + random sequential addition at liquid density, SPC/E geometry), not relaxed or simulated.' },
  { term: 'Graph', value: 'Edges join atoms closer than r_c (minimum image); after T layers atom i is influenced only by atoms ≤ T hops away.' },
  { term: 'Long range', value: 'SPC/E partial charges (O −0.8476 e, H +0.4238 e), ions ±1 e, Au uncharged; lines show minimum-image pairs only, no Ewald sum.' },
];

// "Architecture ≠ checkpoint ≠ dataset ≠ result" — one concrete, sourced example.
// Architecture and training data both feed a checkpoint; a benchmark result
// measures that checkpoint, on a separate test set, under one protocol.
const cards = {
  arch: {
    kind: 'Architecture',
    tone: 'arch',
    name: 'MACE',
    what: 'A recipe: equivariant message passing with higher body-order messages. No weights, no numbers.',
    source: { text: 'Batatia et al., NeurIPS 2022', href: 'https://arxiv.org/abs/2206.07697' },
  },
  data: {
    kind: 'Training dataset',
    tone: 'neutral',
    name: 'MPtrj',
    what: 'Materials Project relaxation trajectories computed with PBE/PBE+U. Its functional and its near-equilibrium sampling shape what any checkpoint trained on it can know.',
    source: { text: 'Deng et al., Nat. Mach. Intell. 2023', href: 'https://arxiv.org/abs/2302.14231' },
  },
  ckpt: {
    kind: 'Checkpoint',
    tone: 'phys',
    name: 'MACE-MP-0 (medium)',
    what: 'One specific set of trained weights. The MACE-MP-0 release alone contains small, medium and large checkpoints — same architecture, same data, different weights.',
    source: { text: 'Batatia et al., arXiv:2401.00096', href: 'https://arxiv.org/abs/2401.00096' },
  },
  result: {
    kind: 'Benchmark result',
    tone: 'lit',
    name: 'A number under a protocol',
    what: 'e.g. one Matbench Discovery metric for that checkpoint, on the benchmark’s own test set (not its training data), under one protocol, on one date. Not a property of “MACE”.',
    source: { text: 'Riebesell et al., arXiv:2308.14920', href: 'https://arxiv.org/abs/2308.14920' },
  },
} as const;
type CardKey = keyof typeof cards;
const edges: Array<{ area: string; label: string; dir: 'right' | 'down-right' | 'up-right' }> = [
  { area: 'e-arch', label: 'instantiated as', dir: 'down-right' },
  { area: 'e-data', label: 'trains', dir: 'up-right' },
  { area: 'e-eval', label: 'evaluated as', dir: 'right' },
];
const order: CardKey[] = ['arch', 'data', 'ckpt', 'result'];
---

<BaseLayout
  title="MLIP Atlas — the science of machine-learned interatomic potentials"
  description="An interactive, evidence-first atlas of machine-learning interatomic potentials: physics you can manipulate, models you can inspect, evidence you can check."
  bareTitle
>
  <section class="hero page-grid">
    <div class="wide hero-inner">
      <div class="hero-text">
        <p class="eyebrow">An evidence-first atlas</p>
        <h1 class="h-display">Mapping the science of machine-learned atomistic modelling</h1>
      </div>
      <div class="hero-side">
        <p class="lede">
          Explore the models. Understand the physics. Discover the limitations. Every figure here is either computed,
          sourced or labelled as a toy — and you can see which.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/physics-lab/">Enter the Physics Lab →</a>
          <a class="btn" href="/method/">How evidence is checked</a>
        </div>
      </div>
    </div>
    <div class="wide hero-figure" id="fig-1">
      <div class="fig-head-row">
        <p class="fig-kicker">Fig. 1 · Which atoms can influence atom <i>i</i>?</p>
        <div class="fig-badges"><Badge label="toy-model" /><Badge label="schematic" /></div>
      </div>
      <div class="ix-slot">
        <InterfaceExplorer client:visible />
        <noscript><p class="noscript">This figure is interactive and needs JavaScript. Fig. 2 below shows the same idea as a static diagram.</p></noscript>
      </div>
      <p class="hero-hint">
        <strong>Try it.</strong> Click any atom to make it atom <i>i</i>, step the message-passing layers <i>T</i>,
        then switch to long range. Hover <i>r</i><sub>c</sub> in the readout to light up the cutoff sphere.
      </p>
      <Assumptions items={ixAssumptions} />
    </div>
  </section>

  <section class="page-grid section" aria-labelledby="flat">
    <div class="wide flat-grid">
      <div>
        <p class="eyebrow">The same question, flattened</p>
        <h2 id="flat" class="h-section">Why distance alone over-counts</h2>
        <p class="section-lede">
          Message passing follows edges, not straight lines. An atom inside the sphere of radius <i>T</i>·<i>r</i><sub>c</sub>
          is reachable only if a chain of at most <i>T</i> edges, each shorter than <i>r</i><sub>c</sub>, leads to it.
          On a flat toy layer you can see every edge.
        </p>
        <p class="section-lede">
          This is the receptive field of a local message-passing potential. Anything outside it — however strong its
          Coulomb field — cannot change the prediction for atom <i>i</i>, unless the model adds an explicit long-range term.
        </p>
      </div>
      <div class="hero-figure-2d">
        <p class="fig-kicker">Fig. 2 · The receptive field on a 2D toy layer</p>
        <ReceptiveFieldFigure />
      </div>
    </div>
  </section>

  <section class="page-grid section" aria-labelledby="four">
    <div class="wide">
      <p class="eyebrow">The Atlas's core rule</p>
      <h2 id="four" class="h-section">Four things that are never the same thing</h2>
      <p class="section-lede">
        “Model X scores Y” hides four different objects. The Atlas gives each its own record and never lets one stand
        in for another.
      </p>
      <div class="chain" role="list">
        {
          order.map((k) => {
            const c = cards[k];
            return (
              <div class={`chain-card tone-${c.tone} area-${k}`} role="listitem">
                <p class="chain-kind">{c.kind}</p>
                <p class="chain-name">{c.name}</p>
                <p class="chain-what">{c.what}</p>
                <a class="chain-src" href={c.source.href}>
                  {c.source.text}
                </a>
              </div>
            );
          })
        }
        {
          edges.map((e) => (
            <div class={`chain-edge ${e.area} dir-${e.dir}`} aria-hidden="true">
              <span>{e.label}</span>
              <svg viewBox="0 0 40 12" width="40" height="12">
                <path d="M0 6h36M31 1.5 37 6l-6 4.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </div>
          ))
        }
      </div>
      <p class="chain-note">
        The checkpoint, not the architecture or the dataset, is what a benchmark measures. Checkpoints trained at
        different levels of theory are not directly comparable, and numbers from different protocols are never merged
        into one ranking.
      </p>
    </div>
  </section>

  <section class="page-grid section" id="destinations" aria-labelledby="dest-h">
    <div class="wide">
      <p class="eyebrow">Destinations</p>
      <h2 id="dest-h" class="h-section">Where the Atlas is going</h2>
      <p class="section-lede">
        Each destination opens only when it has real content behind it — no catalogue entries. Build phases follow
        dependencies: foundations first, then the Physics Lab, the knowledge base, live science, and electrochemistry.
      </p>
      <ul class="dest-grid">
        {
          DESTINATIONS.map((d) => (
            <li class={`dest tone-${d.tone}`}>
              <div class="dest-top">
                <h3 class="h-sub">{d.title}</h3>
                {d.href ? <span class="dest-open">Open</span> : <span class="dest-phase">Phase {d.phase}</span>}
              </div>
              <p class="dest-q">{d.question}</p>
              <p class="dest-sig">{d.signature}</p>
              {d.href && (
                <a class="dest-link" href={d.href} aria-label={`Open ${d.title}`}>
                  <span />
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="page-grid section" aria-labelledby="labels-h">
    <div class="wide labels-band">
      <div>
        <p class="eyebrow">Provenance in view</p>
        <h2 id="labels-h" class="h-section">Every result says how it was made</h2>
        <p class="section-lede">
          No number appears without its label, and no label is decorative: it tells you whether you are looking at a
          toy, a live run, a stored run, a published figure, or something the Atlas re-ran and matched.
        </p>
        <a class="btn" href="/method/#labels">All labels and evidence grades →</a>
      </div>
      <dl class="label-list">
        {
          statusLabels.map((k) => (
            <div>
              <dt>
                <Badge label={k} size="md" />
              </dt>
              <dd>{LABELS[k].definition}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 4.5rem) clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(60rem 30rem at 85% 0%, color-mix(in oklab, var(--atlas-phys) 7%, transparent), transparent 70%),
      radial-gradient(40rem 24rem at 0% 100%, color-mix(in oklab, var(--atlas-arch) 6%, transparent), transparent 70%);
    border-bottom: 1px solid var(--atlas-rule);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.25rem, 4vw, 3.5rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .hero-figure {
    display: grid;
    gap: 0.75rem;
  }
  .fig-head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .fig-head-row .fig-kicker {
    margin: 0;
  }
  .fig-badges {
    display: flex;
    gap: 0.35rem;
  }
  .ix-slot {
    min-height: clamp(560px, 80vh, 860px);
  }
  .noscript {
    padding: 2rem;
    border: 1px dashed var(--atlas-rule-strong);
    border-radius: 0.75rem;
    color: var(--atlas-ink-muted);
  }
  .flat-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 64rem) {
    .flat-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 64rem) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
  }
  .hero-text h1 {
    margin-block: 0.75rem 0;
    font-size: clamp(2.2rem, 4.6vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .lede {
    font: 1.1875rem/1.6 var(--font-serif);
    color: var(--atlas-ink-muted);
    max-width: 34rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block: 1.25rem 0;
  }
  .hero-hint {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--atlas-ink-muted);
    max-width: 52rem;
    padding-left: 0.85rem;
    border-left: 2px solid var(--atlas-phys);
  }
  .hero-hint strong {
    color: var(--atlas-ink);
  }
  .hero-hint i,
  .fig-kicker i {
    font-family: var(--font-serif);
  }
  .fig-kicker {
    font: 600 0.875rem var(--font-sans);
    color: var(--atlas-ink-muted);
    margin-bottom: 0.6rem;
  }

  .section {
    padding-block: clamp(3rem, 6vw, 5rem) 0;
  }
  .section h2 {
    margin-block: 0.5rem 0.75rem;
  }
  .section-lede {
    font: 1.0625rem/1.6 var(--font-serif);
    color: var(--atlas-ink-muted);
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  /* four-object chain: architecture and data feed the checkpoint; the result measures it */
  .chain {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.5rem minmax(0, 1fr) 6rem minmax(0, 1fr);
    grid-template-areas:
      'arch e-arch ckpt e-eval result'
      'data e-data ckpt e-eval result';
    gap: 0.9rem 0;
    align-items: stretch;
  }
  .area-arch { grid-area: arch; }
  .area-data { grid-area: data; }
  .area-ckpt { grid-area: ckpt; align-self: center; }
  .area-result { grid-area: result; align-self: center; }
  .e-arch { grid-area: e-arch; }
  .e-data { grid-area: e-data; }
  .e-eval { grid-area: e-eval; }
  .chain-card {
    padding: 1.1rem 1.1rem 1rem;
    background: var(--atlas-surface);
    border: 1px solid var(--atlas-rule);
    border-top: 3px solid var(--tone);
    border-radius: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .chain-kind {
    font: 650 0.75rem var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tone);
  }
  .chain-name {
    font: 600 1.25rem/1.25 var(--font-serif);
  }
  .chain-what {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--atlas-ink-muted);
    flex: 1;
  }
  .chain-src {
    font-size: 0.75rem;
    color: var(--atlas-lit);
    text-decoration: none;
  }
  .chain-src:hover {
    text-decoration: underline;
  }
  .chain-edge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    color: var(--atlas-ink-faint);
    font: italic 0.75rem/1.1 var(--font-serif);
    text-align: center;
  }
  .dir-down-right svg { transform: rotate(22deg); }
  .dir-up-right svg { transform: rotate(-22deg); }
  .chain-note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--atlas-ink-faint);
    max-width: 52rem;
  }
  @media (max-width: 64rem) {
    .chain {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'arch' 'e-arch' 'data' 'e-data' 'ckpt' 'e-eval' 'result';
      max-width: 34rem;
      gap: 0.3rem;
    }
    .chain-edge {
      flex-direction: row;
      padding-block: 0.3rem;
    }
    .chain-edge svg {
      transform: rotate(90deg);
    }
  }
  .tone-arch { --tone: var(--atlas-arch); }
  .tone-phys { --tone: var(--atlas-phys); }
  .tone-lit { --tone: var(--atlas-lit); }
  .tone-fail { --tone: var(--atlas-fail); }
  .tone-caveat { --tone: var(--atlas-caveat); }
  .tone-neutral { --tone: var(--atlas-neutral); }

  /* destinations */
  .dest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.9rem;
  }
  .dest {
    position: relative;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--atlas-rule);
    border-radius: 0.7rem;
    background: var(--atlas-surface);
    box-shadow: inset 3px 0 0 var(--tone);
  }
  .dest-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }
  .dest-phase,
  .dest-open {
    font: 600 0.6875rem var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--atlas-ink-faint);
    white-space: nowrap;
  }
  .dest-open {
    color: var(--atlas-verified);
  }
  .dest-q {
    font: italic 1rem/1.4 var(--font-serif);
    margin-block: 0.4rem;
  }
  .dest-sig {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--atlas-ink-muted);
  }
  .dest-link span {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .dest:has(.dest-link):hover {
    border-color: var(--atlas-rule-strong);
  }
  .dest-link:focus-visible {
    outline: none;
  }
  .dest:has(.dest-link:focus-visible) {
    outline: 2px solid var(--atlas-arch);
    outline-offset: 2px;
  }

  /* labels band */
  .labels-band {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 2rem 3rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--atlas-rule);
    border-radius: 0.9rem;
    background: var(--atlas-surface);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  @media (max-width: 56rem) {
    .labels-band {
      grid-template-columns: 1fr;
    }
  }
  .label-list {
    display: grid;
    gap: 1rem;
  }
  .label-list dd {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--atlas-ink-muted);
  }
</style>

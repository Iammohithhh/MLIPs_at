  }
  .block {
    margin-top: clamp(2rem, 4vw, 3rem);
    font: 1.0625rem/1.7 var(--font-serif);
    color: var(--atlas-ink);
  }
  .block p {
    margin-block: 0 1rem;
  }
  .block i {
    font-style: italic;
  }

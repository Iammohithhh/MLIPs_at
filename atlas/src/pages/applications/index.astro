---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import type { Application, Concept } from '~/content/schemas';
import { APPLICATION_LABS as LABS } from '~/lib/record-urls';

const apps = (await getCollection('applications')).map((e) => ({ id: e.id, data: e.data as Application }));
const concepts = new Map((await getCollection('concepts')).map((e) => [e.id, e.data as Concept]));
---

<BaseLayout
  title="Applications"
  description="What matters for your system: application labs that connect the physics a domain depends on to what a machine-learning potential must get right there."
>
  <article class="page-grid ap">
    <header class="wide head">
      <p class="eyebrow">Applications</p>
      <h1 class="h-display">What matters for my system?</h1>
      <p class="lede">
        Each application starts from the physics that decides results in that domain, builds it as something you can
        change, and lists what a model has to handle there. Models are described as evaluated for related systems,
        never as recommended.
      </p>
    </header>

    <ul class="wide apps">
      {
        apps.map((a) => (
          <li class="app">
            {LABS.has(a.id) ? <a class="t" href={`/applications/${a.id}/`}>{a.data.title}</a> : <span class="t">{a.data.title}</span>}
            <p class="s">{a.data.summary}</p>
            {a.data.key_physics.length > 0 && (
              <p class="k">
                Key physics:{' '}
                {a.data.key_physics.map((k, i) => (
                  <>
                    {i > 0 && ', '}
                    {concepts.get(k)?.title ?? k}
                  </>
                ))}
              </p>
            )}
            {a.data.requirements.length > 0 && (
              <ul class="req">
                {a.data.requirements.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            )}
            {LABS.has(a.id) ? <a class="go" href={`/applications/${a.id}/`}>Open the lab →</a> : <span class="m">Lab not built yet</span>}
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>

<style>
  .ap {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }
  .head h1 {
    margin-block: 0.6rem 1rem;
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    text-wrap: balance;
  }
  .lede {
    font: 1.1875rem/1.6 var(--font-serif);
    color: var(--atlas-ink-muted);
    max-width: 46rem;
  }
  .apps {
    list-style: none;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    gap: 1rem;
  }
  .app {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.2rem 1.35rem;
    border: 1px solid color-mix(in oklab, var(--atlas-phys) 35%, var(--atlas-rule));
    border-left: 4px solid var(--atlas-phys);
    border-radius: 0.75rem;
    background: var(--atlas-surface);
    box-shadow: var(--atlas-shadow);
  }
  .t {
    font: 600 1.4rem/1.25 var(--font-serif);
    color: inherit;
    text-decoration: none;
  }
  a.t:hover {
    text-decoration: underline;
  }
  .s {
    margin: 0;
    font: 0.95rem/1.55 var(--font-sans);
    color: var(--atlas-ink-muted);
  }
  .k {
    margin: 0;
    font: 0.8rem var(--font-mono);
    color: var(--atlas-ink-faint);
  }
  .req {
    margin: 0;
    padding-left: 1.1rem;
    font: 0.9rem/1.5 var(--font-sans);
    color: var(--atlas-ink);
  }
  .go {
    font: 600 0.875rem var(--font-sans);
    color: var(--atlas-phys);
    text-decoration: none;
  }
  .m {
    font: 0.75rem var(--font-mono);
    color: var(--atlas-ink-faint);
  }
</style>
